<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elsx_tally_sync_log_view_list" model="ir.ui.view">
        <field name="name">elsx.tally.sync.log.list</field>
        <field name="model">elsx.tally.sync.log</field>
        <field name="arch" type="xml">
            <list string="Tally Sync Logs" create="0" edit="0">
                <field name="create_date"/>
                <field name="move_id"/>
                <field name="operation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"/>
                <field name="gateway_url"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="elsx_tally_sync_log_view_form" model="ir.ui.view">
        <field name="name">elsx.tally.sync.log.form</field>
        <field name="model">elsx.tally.sync.log</field>
        <field name="arch" type="xml">
            <form string="Tally Sync Log" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="move_id"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="gateway_url"/>
                        <field name="user_id"/>
                    </group>
                    <notebook>
                        <page string="Request XML">
                            <field name="request_payload" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Response">
                            <field name="response_payload" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Error">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elsx_tally_sync_log" model="ir.actions.act_window">
        <field name="name">Tally Sync Logs</field>
        <field name="res_model">elsx.tally.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_elsx_tally_sync_log"
              name="Tally Sync Logs"
              parent="account.account_logs_menu"
              action="action_elsx_tally_sync_log"
              groups="account.group_account_readonly"
              sequence="80"/>
</odoo>
