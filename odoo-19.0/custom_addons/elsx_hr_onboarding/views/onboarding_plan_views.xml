<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban + Form + List views for Onboarding Plans -->
    <record id="view_elsx_onboarding_plan_form" model="ir.ui.view">
        <field name="name">elsx.onboarding.plan.form</field>
        <field name="model">elsx.onboarding.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_onboarding" string="Start Onboarding" type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_mark_complete" string="Mark Complete" type="object" class="oe_highlight btn-success"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Onboarding Plan Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="hr_responsible_id"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Onboarding Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="task_type"/>
                                    <field name="responsible_id"/>
                                    <field name="deadline"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-muted="state == 'pending'"/>
                                    <button name="action_mark_done" string="✓ Done" type="object" class="btn btn-sm btn-success"
                                            invisible="state == 'done'"/>
                                    <button name="action_create_sign_request" string="Create Sign Request" type="object"
                                            class="btn btn-sm btn-outline-primary"
                                            invisible="task_type != 'sign_document'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_elsx_onboarding_plan_list" model="ir.ui.view">
        <field name="name">elsx.onboarding.plan.list</field>
        <field name="model">elsx.onboarding.plan</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-warning="state == 'in_progress'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="hr_responsible_id"/>
                <field name="start_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_elsx_onboarding_plan_kanban" model="ir.ui.view">
        <field name="name">elsx.onboarding.plan.kanban</field>
        <field name="model">elsx.onboarding.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="progress"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="employee_id"/>
                                <div class="mt-2">
                                    <field name="progress" widget="progressbar"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_elsx_onboarding_plan" model="ir.actions.act_window">
        <field name="name">Onboarding Plans</field>
        <field name="res_model">elsx.onboarding.plan</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_elsx_onboarding_root" name="Onboarding" parent="hr.menu_hr_root" sequence="5"/>
    <menuitem id="menu_elsx_onboarding_plans" name="Plans" parent="menu_elsx_onboarding_root"
              action="action_elsx_onboarding_plan" sequence="10"/>
</odoo>
