<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Passive app group kept for upgrade compatibility only. It is not implied by Internal User. -->
    <record id="group_elsx_saas_app_user" model="res.groups">
        <field name="name">ELSx SaaS App Store User (Disabled)</field>
        <field name="comment">Compatibility group only. SaaS app-store access is disabled while elsx_saas.enabled is 0.</field>
    </record>

    <!-- SaaS User: not assigned automatically while the SaaS system is deactivated. -->
    <record id="group_elsx_saas_user" model="res.groups">
        <field name="name">ELSx SaaS User (Disabled)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Compatibility group only. SaaS user portal access is disabled while elsx_saas.enabled is 0.</field>
    </record>

    <!-- SaaS Administrator: not implied by System Administrator while deactivated. -->
    <record id="group_elsx_saas_admin" model="res.groups">
        <field name="name">ELSx SaaS Administrator (Disabled)</field>
        <field name="implied_ids" eval="[(4, ref('group_elsx_saas_user'))]"/>
        <field name="comment">Compatibility group only. SaaS admin console access is disabled while elsx_saas.enabled is 0.</field>
    </record>

    <!-- Record Rules for SaaS Users (Isolation) -->
    <record id="rule_elsx_saas_tenant_user" model="ir.rule">
        <field name="name">SaaS Tenant: User can only see own tenant</field>
        <field name="model_id" ref="model_elsx_saas_tenant"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_user'))]"/>
    </record>

    <record id="rule_elsx_saas_subscription_user" model="ir.rule">
        <field name="name">SaaS Subscription: User can only see own subscriptions</field>
        <field name="model_id" ref="model_elsx_saas_subscription"/>
        <field name="domain_force">[('tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_user'))]"/>
    </record>

    <record id="rule_elsx_saas_billing_cycle_user" model="ir.rule">
        <field name="name">SaaS Billing: User can only see own invoices</field>
        <field name="model_id" ref="model_elsx_saas_billing_cycle"/>
        <field name="domain_force">[('tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_user'))]"/>
    </record>

    <record id="rule_elsx_saas_module_request_user" model="ir.rule">
        <field name="name">SaaS Module Request: User can only see own requests</field>
        <field name="model_id" ref="model_elsx_saas_module_request"/>
        <field name="domain_force">[('tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_user'))]"/>
    </record>

    <record id="rule_elsx_saas_support_ticket_user" model="ir.rule">
        <field name="name">SaaS Support Ticket: User can only see own tickets</field>
        <field name="model_id" ref="model_elsx_saas_support_ticket"/>
        <field name="domain_force">[('tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_user'))]"/>
    </record>

    <!-- Record Rules for SaaS Admins (Global Access, only if assigned manually later) -->
    <record id="rule_elsx_saas_tenant_admin" model="ir.rule">
        <field name="name">SaaS Tenant: Admin sees all</field>
        <field name="model_id" ref="model_elsx_saas_tenant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_admin'))]"/>
    </record>

    <record id="rule_elsx_saas_subscription_admin" model="ir.rule">
        <field name="name">SaaS Subscription: Admin sees all</field>
        <field name="model_id" ref="model_elsx_saas_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_admin'))]"/>
    </record>

    <record id="rule_elsx_saas_billing_cycle_admin" model="ir.rule">
        <field name="name">SaaS Billing: Admin sees all</field>
        <field name="model_id" ref="model_elsx_saas_billing_cycle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_admin'))]"/>
    </record>

    <record id="rule_elsx_saas_module_request_admin" model="ir.rule">
        <field name="name">SaaS Module Request: Admin sees all</field>
        <field name="model_id" ref="model_elsx_saas_module_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_admin'))]"/>
    </record>

    <record id="rule_elsx_saas_support_ticket_admin" model="ir.rule">
        <field name="name">SaaS Support Ticket: Admin sees all</field>
        <field name="model_id" ref="model_elsx_saas_support_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_elsx_saas_admin'))]"/>
    </record>
</odoo>
