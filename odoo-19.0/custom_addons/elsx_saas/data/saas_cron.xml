<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Detect overdue billing cycles daily -->
        <record id="cron_detect_overdue_billing" model="ir.cron">
            <field name="name">SaaS: Detect Overdue Billing Cycles</field>
            <field name="model_id" ref="model_elsx_saas_billing_cycle"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <!-- Auto-generate invoices for due subscriptions daily -->
        <record id="cron_auto_generate_invoices" model="ir.cron">
            <field name="name">SaaS: Auto-Generate Subscription Invoices</field>
            <field name="model_id" ref="model_elsx_saas_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_generate_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
