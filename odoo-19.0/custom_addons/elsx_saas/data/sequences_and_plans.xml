<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequences for automatic numbering -->
    <record id="seq_elsx_saas_support_ticket" model="ir.sequence">
        <field name="name">ELSx SaaS Support Ticket</field>
        <field name="code">elsx.saas.support.ticket</field>
        <field name="prefix">TICKET/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_elsx_saas_billing_cycle" model="ir.sequence">
        <field name="name">ELSx SaaS Billing Cycle</field>
        <field name="code">elsx.saas.billing.cycle</field>
        <field name="prefix">INV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Default Billing Plans -->
    <record id="plan_starter" model="elsx.saas.billing.plan">
        <field name="name">Starter</field>
        <field name="code">starter</field>
        <field name="sequence">10</field>
        <field name="setup_fee">99</field>
        <field name="monthly_price">29</field>
        <field name="annual_price">290</field>
        <field name="max_users">10</field>
        <field name="storage_quota_gb">5</field>
        <field name="api_calls_per_day">10000</field>
        <field name="enable_crm">True</field>
        <field name="enable_accounting">True</field>
        <field name="enable_whatsapp">False</field>
        <field name="enable_attendance">False</field>
        <field name="support_tier">standard</field>
        <field name="allow_monthly">True</field>
        <field name="allow_annual">True</field>
        <field name="is_active">True</field>
    </record>

    <record id="plan_business" model="elsx.saas.billing.plan">
        <field name="name">Business</field>
        <field name="code">business</field>
        <field name="sequence">20</field>
        <field name="setup_fee">299</field>
        <field name="monthly_price">99</field>
        <field name="annual_price">950</field>
        <field name="max_users">100</field>
        <field name="storage_quota_gb">100</field>
        <field name="api_calls_per_day">100000</field>
        <field name="enable_crm">True</field>
        <field name="enable_accounting">True</field>
        <field name="enable_whatsapp">True</field>
        <field name="enable_attendance">True</field>
        <field name="enable_tally">False</field>
        <field name="support_tier">priority</field>
        <field name="allow_monthly">True</field>
        <field name="allow_annual">True</field>
        <field name="is_active">True</field>
    </record>

    <record id="plan_enterprise" model="elsx.saas.billing.plan">
        <field name="name">Enterprise</field>
        <field name="code">enterprise</field>
        <field name="sequence">30</field>
        <field name="setup_fee">999</field>
        <field name="monthly_price">499</field>
        <field name="annual_price">4990</field>
        <field name="max_users">500</field>
        <field name="storage_quota_gb">500</field>
        <field name="api_calls_per_day">1000000</field>
        <field name="enable_crm">True</field>
        <field name="enable_accounting">True</field>
        <field name="enable_whatsapp">True</field>
        <field name="enable_attendance">True</field>
        <field name="enable_tally">True</field>
        <field name="enable_face_attendance">True</field>
        <field name="support_tier">enterprise</field>
        <field name="allow_monthly">True</field>
        <field name="allow_annual">True</field>
        <field name="is_active">True</field>
    </record>

    <!-- Add-ons -->
    <record id="addon_extra_users" model="elsx.saas.addon">
        <field name="name">Extra 10 Users</field>
        <field name="sequence">10</field>
        <field name="monthly_price">19</field>
        <field name="is_active">True</field>
    </record>

    <record id="addon_storage" model="elsx.saas.addon">
        <field name="name">Extra 100GB Storage</field>
        <field name="sequence">20</field>
        <field name="monthly_price">9</field>
        <field name="is_active">True</field>
    </record>

    <record id="addon_priority_support" model="elsx.saas.addon">
        <field name="name">Priority Support Upgrade</field>
        <field name="sequence">30</field>
        <field name="monthly_price">99</field>
        <field name="is_active">True</field>
    </record>
</odoo>
