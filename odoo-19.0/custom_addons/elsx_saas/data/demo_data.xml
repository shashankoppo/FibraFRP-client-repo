<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo SaaS Tenants -->
        <record id="demo_tenant_startup" model="elsx.saas.tenant">
            <field name="name">techstartup</field>
            <field name="admin_email">admin@techstartup.com</field>
            <field name="plan">starter</field>
            <field name="state">active</field>
            <field name="storage_quota_gb">10</field>
            <field name="max_users">25</field>
            <field name="custom_domain">erp.techstartup.com</field>
        </record>

        <record id="demo_tenant_enterprise" model="elsx.saas.tenant">
            <field name="name">globalcorp</field>
            <field name="admin_email">it@globalcorp.com</field>
