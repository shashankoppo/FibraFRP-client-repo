<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================
             UPGRADE LOG VIEWS
             ======================================== -->

        <!-- Upgrade Log List View -->
        <record id="elsx_saas_upgrade_log_list" model="ir.ui.view">
            <field name="name">elsx.saas.upgrade.log.list</field>
            <field name="model">elsx.saas.upgrade.log</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="upgrade_id"/>
                    <field name="from_version"/>
                    <field name="to_version"/>
                    <field name="upgrade_date"/>
                    <field name="status" decoration-danger="status == 'failed'" decoration-warning="status in ('pre_checks', 'migrating')" decoration-success="status == 'completed'"/>
                    <field name="total_records_migrated"/>
                    <field name="duration_minutes"/>
                </list>
            </field>
        </record>

        <!-- Upgrade Log Form View -->
        <record id="elsx_saas_upgrade_log_form" model="ir.ui.view">
            <field name="name">elsx.saas.upgrade.log.form</field>
            <field name="model">elsx.saas.upgrade.log</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <header>
                        <button name="action_rollback" type="object" string="Show Restore Guidance" class="oe_highlight" invisible="not can_rollback"/>
                        <field name="status" widget="statusbar" options="{'clickable': False}"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning o_elsx_saas_notice" role="alert">
                            <strong>Manual restore only.</strong>
                            This screen records upgrade history. Restoring a database or filestore must be done from the approved server-side restore script after backup verification.
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="upgrade_id" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="from_version" readonly="1"/>
                                <field name="to_version" readonly="1"/>
                                <field name="upgrade_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_records_migrated" readonly="1"/>
                                <field name="duration_minutes" readonly="1"/>
                                <field name="created_by" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Pre-Check Results">
                                <field name="pre_check_results" readonly="1" widget="text"/>
                            </page>
                            <page string="Post-Check Results">
                                <field name="post_check_results" readonly="1" widget="text"/>
                            </page>
                            <page string="Backup Information">
                                <group>
                                    <field name="backup_location" readonly="1"/>
                                    <field name="backup_size_mb" readonly="1"/>
                                    <field name="backup_verified" readonly="1"/>
                                </group>
                            </page>
                            <page string="Logs" invisible="not upgrade_log">
                                <field name="upgrade_log" readonly="1" widget="text" nolabel="1"/>
                            </page>
                            <page string="Error Details" invisible="not error_message">
                                <field name="error_message" readonly="1" widget="text" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Upgrade Log Action -->
        <record id="action_elsx_saas_upgrade_log" model="ir.actions.act_window">
            <field name="name">Upgrade Logs</field>
            <field name="res_model">elsx.saas.upgrade.log</field>
            <field name="view_mode">list,form</field>
            <field name="help">View complete upgrade history with rollback capability</field>
        </record>

        <!-- Version Check Views -->
        <record id="elsx_saas_version_check_form" model="ir.ui.view">
            <field name="name">elsx.saas.version.check.form</field>
            <field name="model">elsx.saas.version.check</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <sheet>
                        <div class="alert alert-info o_elsx_saas_notice" role="alert">
                            <strong>Compatibility snapshot.</strong>
                            This record is informational and does not change installed modules.
                        </div>
                        <group>
                            <field name="module_name" readonly="1"/>
                            <field name="current_version" readonly="1"/>
                            <field name="database_version" readonly="1"/>
                            <field name="is_compatible" readonly="1"/>
                            <field name="check_date" readonly="1"/>
                        </group>
                        <field name="compatibility_issues" readonly="1" nolabel="1" invisible="not compatibility_issues"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ========================================
             ENTERPRISE FEATURES VIEWS
             ======================================== -->

        <!-- Custom Field List View -->
        <record id="elsx_saas_custom_field_list" model="ir.ui.view">
            <field name="name">elsx.saas.custom.field.list</field>
            <field name="model">elsx.saas.custom.field</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="field_name"/>
                    <field name="field_label"/>
                    <field name="model_id"/>
                    <field name="field_type"/>
                    <field name="required"/>
                    <field name="is_active" decoration-danger="not is_active"/>
                </list>
            </field>
        </record>

        <!-- Custom Field Form View -->
        <record id="elsx_saas_custom_field_form" model="ir.ui.view">
            <field name="name">elsx.saas.custom.field.form</field>
            <field name="model">elsx.saas.custom.field</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <sheet>
                        <div class="alert alert-warning o_elsx_saas_notice" role="alert">
                            <strong>Design registry.</strong>
                            Custom field records document requirements; no database field is created here until a reviewed technical change is deployed.
                        </div>
                        <group>
                            <field name="field_name" readonly="1"/>
                            <field name="field_label"/>
                            <field name="model_id"/>
                            <field name="field_type"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="required"/>
                            <field name="readonly"/>
                            <field name="stored"/>
                        </group>
                        <field name="selection_values" invisible="field_type != 'selection'"/>
                        <field name="help_text"/>
                        <field name="default_value"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Workflow Automation List -->
        <record id="elsx_saas_workflow_automation_list" model="ir.ui.view">
            <field name="name">elsx.saas.workflow.automation.list</field>
            <field name="model">elsx.saas.workflow.automation</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="trigger_on"/>
                    <field name="action_type"/>
                    <field name="is_active" decoration-danger="not is_active"/>
                </list>
            </field>
        </record>

        <!-- Workflow Automation Form -->
        <record id="elsx_saas_workflow_automation_form" model="ir.ui.view">
            <field name="name">elsx.saas.workflow.automation.form</field>
            <field name="model">elsx.saas.workflow.automation</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <sheet>
                        <div class="alert alert-warning o_elsx_saas_notice" role="alert">
                            <strong>Automation blueprint.</strong>
                            Workflows are captured for review. Production execution must be implemented through reviewed code or approved automation jobs.
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="trigger_on"/>
                        </group>
                        <field name="description"/>
                        <field name="trigger_conditions" widget="ace" options="{'mode': 'python'}"/>
                        <field name="action_details" widget="ace" options="{'mode': 'python'}"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Scheduled Job List -->
        <record id="elsx_saas_scheduled_job_list" model="ir.ui.view">
            <field name="name">elsx.saas.scheduled.job.list</field>
            <field name="model">elsx.saas.scheduled.job</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="name"/>
                    <field name="job_type"/>
                    <field name="frequency"/>
                    <field name="is_active" decoration-danger="not is_active"/>
                    <field name="execution_count"/>
                    <field name="last_result" decoration-danger="last_result == 'error'" decoration-warning="last_result == 'warning'"/>
                </list>
            </field>
        </record>

        <!-- Scheduled Job Form -->
        <record id="elsx_saas_scheduled_job_form" model="ir.ui.view">
            <field name="name">elsx.saas.scheduled.job.form</field>
            <field name="model">elsx.saas.scheduled.job</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <header>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning o_elsx_saas_notice" role="alert">
                            <strong>Scheduled job registry.</strong>
                            Do not place unsafe Python here for production execution. Use reviewed server-side jobs for live tenants.
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="job_type"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="schedule_time" invisible="frequency in ['custom']"/>
                            <field name="cron_expression" invisible="frequency != 'custom'"/>
                        </group>
                        <field name="description"/>
                        <field name="python_code" widget="ace" options="{'mode': 'python'}" invisible="job_type != 'custom'"/>
                        <group>
                            <field name="notify_on_error"/>
                            <field name="notification_emails" invisible="not notify_on_error"/>
                        </group>
                        <group>
                            <field name="execution_count" readonly="1"/>
                            <field name="last_execution" readonly="1"/>
                            <field name="last_result" readonly="1"/>
                        </group>
                        <field name="last_error" readonly="1" nolabel="1" invisible="not last_error"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Security Policy List -->
        <record id="elsx_saas_security_policy_list" model="ir.ui.view">
            <field name="name">elsx.saas.security.policy.list</field>
            <field name="model">elsx.saas.security.policy</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="name"/>
                    <field name="policy_type"/>
                    <field name="is_active" decoration-danger="not is_active"/>
                </list>
            </field>
        </record>

        <!-- Security Policy Form -->
        <record id="elsx_saas_security_policy_form" model="ir.ui.view">
            <field name="name">elsx.saas.security.policy.form</field>
            <field name="model">elsx.saas.security.policy</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <sheet>
                        <div class="alert alert-info o_elsx_saas_notice" role="alert">
                            <strong>Security policy registry.</strong>
                            Use this to document controls. Enforcement requires the matching security implementation or deployment rule.
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="policy_type"/>
                            <field name="is_active"/>
                        </group>
                        <field name="description"/>

                        <!-- IP Whitelist -->
                        <group invisible="policy_type != 'ip_whitelist'">
                            <field name="ip_restriction_enabled"/>
                            <field name="allowed_ips" widget="ace"/>
                        </group>

                        <!-- Rate Limiting -->
                        <group invisible="policy_type != 'rate_limit'">
                            <field name="rate_limit_enabled"/>
                            <field name="requests_per_minute"/>
                            <field name="requests_per_hour"/>
                        </group>

                        <!-- Password Policy -->
                        <group invisible="policy_type != 'password_policy'">
                            <field name="min_password_length"/>
                            <field name="require_uppercase"/>
                            <field name="require_lowercase"/>
                            <field name="require_numbers"/>
                            <field name="require_special"/>
                            <field name="password_expiry_days"/>
                        </group>

                        <!-- Advanced Security -->
                        <group invisible="policy_type not in ['ip_whitelist', 'rate_limit']">
                            <field name="sso_enabled"/>
                            <field name="two_fa_enabled"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Report Template List -->
        <record id="elsx_saas_report_template_list" model="ir.ui.view">
            <field name="name">elsx.saas.report.template.list</field>
            <field name="model">elsx.saas.report.template</field>
            <field name="arch" type="xml">
                <list class="o_elsx_saas_list">
                    <field name="name"/>
                    <field name="report_type"/>
                    <field name="generation_frequency"/>
                    <field name="auto_generate"/>
                    <field name="is_active" decoration-danger="not is_active"/>
                </list>
            </field>
        </record>

        <!-- Report Template Form -->
        <record id="elsx_saas_report_template_form" model="ir.ui.view">
            <field name="name">elsx.saas.report.template.form</field>
            <field name="model">elsx.saas.report.template</field>
            <field name="arch" type="xml">
                <form class="o_elsx_saas_form">
                    <sheet>
                        <div class="alert alert-info o_elsx_saas_notice" role="alert">
                            <strong>Report template registry.</strong>
                            Templates define report intent and schedule; generated reports should be reviewed before delivery.
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="report_type"/>
                            <field name="is_active"/>
                        </group>
                        <field name="description"/>
                        <group>
                            <field name="data_model"/>
                            <field name="field_list"/>
                        </group>
                        <field name="filter_domains" widget="ace"/>
                        <group>
                            <field name="auto_generate"/>
                            <field name="generation_frequency" invisible="not auto_generate"/>
                        </group>
                        <group>
                            <field name="auto_send"/>
                            <field name="recipient_emails" invisible="not auto_send"/>
                        </group>
                        <group>
                            <field name="generation_count" readonly="1"/>
                            <field name="last_generated" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu Items for Enterprise Features -->
        <menuitem id="saas_menu_settings"
                  name="Settings"
                  parent="menu_elsx_saas_root"
                  sequence="50"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <record id="action_elsx_saas_custom_field" model="ir.actions.act_window">
            <field name="name">Custom Fields</field>
            <field name="res_model">elsx.saas.custom.field</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_elsx_saas_custom_field"
                  name="Custom Fields"
                  parent="saas_menu_settings"
                  action="action_elsx_saas_custom_field"
                  sequence="10"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <!-- Automation Menu -->
        <menuitem id="saas_menu_automation"
                  name="Automation"
                  parent="menu_elsx_saas_root"
                  sequence="40"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <record id="action_elsx_saas_workflow_automation" model="ir.actions.act_window">
            <field name="name">Workflows</field>
            <field name="res_model">elsx.saas.workflow.automation</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_elsx_saas_workflow_automation"
                  name="Workflow Automation"
                  parent="saas_menu_automation"
                  action="action_elsx_saas_workflow_automation"
                  sequence="10"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <record id="action_elsx_saas_scheduled_job" model="ir.actions.act_window">
            <field name="name">Scheduled Jobs</field>
            <field name="res_model">elsx.saas.scheduled.job</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_elsx_saas_scheduled_job"
                  name="Scheduled Jobs"
                  parent="saas_menu_automation"
                  action="action_elsx_saas_scheduled_job"
                  sequence="20"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <!-- Security Menu -->
        <menuitem id="saas_menu_security"
                  name="Security"
                  parent="menu_elsx_saas_root"
                  sequence="30"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <record id="action_elsx_saas_security_policy" model="ir.actions.act_window">
            <field name="name">Security Policies</field>
            <field name="res_model">elsx.saas.security.policy</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_elsx_saas_security_policy"
                  name="Security Policies"
                  parent="saas_menu_security"
                  action="action_elsx_saas_security_policy"
                  sequence="10"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <!-- Reports Menu -->
        <menuitem id="saas_menu_reports_advanced"
                  name="Report Templates"
                  parent="menu_elsx_saas_root"
                  sequence="20"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <record id="action_elsx_saas_report_template" model="ir.actions.act_window">
            <field name="name">Report Templates</field>
            <field name="res_model">elsx.saas.report.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_elsx_saas_report_template"
                  name="Report Templates"
                  parent="saas_menu_reports_advanced"
                  action="action_elsx_saas_report_template"
                  sequence="10"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <!-- Upgrade Management Menu -->
        <menuitem id="saas_menu_system"
                  name="System"
                  parent="menu_elsx_saas_root"
                  sequence="60"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

        <menuitem id="menu_elsx_saas_upgrade_log"
                  name="Upgrade Logs"
                  parent="saas_menu_system"
                  action="action_elsx_saas_upgrade_log"
                  sequence="10"
                  groups="base.group_system,elsx_saas.group_elsx_saas_admin"/>

    </data>
</odoo>
