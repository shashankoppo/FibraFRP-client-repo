<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elsx_saas_dashboard_form" model="ir.ui.view">
        <field name="name">elsx.saas.dashboard.form</field>
        <field name="model">elsx.saas.dashboard</field>
        <field name="arch" type="xml">
            <form string="ELSx SaaS Command Center" class="o_elsx_saas_form o_elsx_saas_dashboard_form">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="o_elsx_saas_dashboard_hero">
                        <div>
                            <h1>ELSx SaaS Command Center</h1>
                            <p>Control tenants, billing, module requests, security posture, and rollout readiness without changing tenant databases from the browser.</p>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tenants" type="object" class="oe_stat_button" icon="fa-building-o">
                            <field name="tenant_count" widget="statinfo" string="Tenants"/>
                        </button>
                        <button name="action_open_tenant_warnings" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="warning_tenant_count" widget="statinfo" string="Needs Review"/>
                        </button>
                        <button name="action_open_module_requests" type="object" class="oe_stat_button" icon="fa-puzzle-piece">
                            <field name="pending_module_request_count" widget="statinfo" string="Module Queue"/>
                        </button>
                        <button name="action_open_high_risk_requests" type="object" class="oe_stat_button" icon="fa-shield">
                            <field name="high_risk_module_request_count" widget="statinfo" string="High Risk"/>
                        </button>
                        <button name="action_open_billing_cycles" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="open_invoice_count" widget="statinfo" string="Open Billing"/>
                        </button>
                        <button name="action_open_support_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="open_ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>

                    <div class="o_elsx_saas_dashboard_grid">
                        <section class="o_elsx_saas_panel">
                            <h2>Business Health</h2>
                            <div class="o_elsx_saas_metric_rows">
                                <div><span>Active tenants</span><field name="active_tenant_count" readonly="1"/></div>
                                <div><span>Suspended/archived</span><field name="suspended_tenant_count" readonly="1"/></div>
                                <div><span>MRR</span><field name="mrr_total" readonly="1"/></div>
                                <div><span>ARR</span><field name="arr_total" readonly="1"/></div>
                            </div>
                        </section>
                        <section class="o_elsx_saas_panel">
                            <h2>Billing Cycle</h2>
                            <div class="o_elsx_saas_metric_rows">
                                <div><span>Open invoices</span><field name="open_invoice_count" readonly="1"/></div>
                                <div><span>Overdue invoices</span><field name="overdue_invoice_count" readonly="1"/></div>
                                <div><span>Open support tickets</span><field name="open_ticket_count" readonly="1"/></div>
                                <div><span>SLA breached</span><field name="breached_ticket_count" readonly="1"/></div>
                            </div>
                        </section>
                    </div>

                    <div class="o_elsx_saas_cia_grid">
                        <section class="o_elsx_saas_panel o_elsx_saas_cia_card">
                            <h2>Confidentiality</h2>
                            <field name="confidentiality_status" widget="badge" readonly="1"/>
                            <field name="confidentiality_note" readonly="1" nolabel="1"/>
                        </section>
                        <section class="o_elsx_saas_panel o_elsx_saas_cia_card">
                            <h2>Integrity</h2>
                            <field name="integrity_status" widget="badge" readonly="1"/>
                            <field name="integrity_note" readonly="1" nolabel="1"/>
                        </section>
                        <section class="o_elsx_saas_panel o_elsx_saas_cia_card">
                            <h2>Availability</h2>
                            <field name="availability_status" widget="badge" readonly="1"/>
                            <field name="availability_note" readonly="1" nolabel="1"/>
                        </section>
                    </div>

                    <group string="Operator Runbook">
                        <field name="operator_guidance" nolabel="1" readonly="1"/>
                    </group>

                    <div class="alert alert-info o_elsx_saas_notice" role="alert">
                        <strong>Production safety:</strong> This dashboard reads SaaS governance records only. It does not create/drop databases, install modules, rewrite WhatsApp settings, or touch client operational data.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elsx_saas_dashboard" model="ir.actions.act_window">
        <field name="name">SaaS Command Center</field>
        <field name="res_model">elsx.saas.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_name': 'ELSx SaaS Command Center', 'form_view_initial_mode': 'edit'}</field>
    </record>

    <menuitem id="menu_elsx_saas_dashboard"
              name="Command Center"
              parent="menu_elsx_saas_root"
              action="action_elsx_saas_dashboard"
              sequence="1"
              groups="elsx_saas.group_elsx_saas_admin"/>
</odoo>