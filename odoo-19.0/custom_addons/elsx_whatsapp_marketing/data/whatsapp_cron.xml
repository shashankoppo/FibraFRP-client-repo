<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_whatsapp_drip_campaigns" model="ir.cron">
            <field name="name">WhatsApp: Process Drip Campaigns</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_campaign_participant"/>
            <field name="state">code</field>
            <field name="code">model.process_drip_campaigns()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        
        <record id="ir_cron_process_whatsapp_queue" model="ir.cron">
            <field name="name">WhatsApp: Process Broadcast Queue</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_global_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_resume_delayed_bot_flows" model="ir.cron">
            <field name="name">WhatsApp: Resume Delayed Bot Flows</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_bot_flow_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_resume_delayed_flows()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- PHASE 2: Process Scheduled Messages (NEW) -->
        <record id="ir_cron_process_scheduled_messages" model="ir.cron">
            <field name="name">WhatsApp: Process Scheduled Messages</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_scheduled_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_scheduled()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- PHASE 2: Cleanup Old Webhook Logs (NEW) -->
        <record id="ir_cron_cleanup_webhook_logs" model="ir.cron">
            <field name="name">WhatsApp: Cleanup Old Webhook Logs</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_webhook_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- PHASE 2: Retry Failed Messages with Exponential Backoff (NEW) -->
        <record id="ir_cron_retry_failed_messages" model="ir.cron">
            <field name="name">WhatsApp: Retry Failed Messages</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Retention cleanup is intentionally disabled by default because it deletes chat history. -->
        <record id="ir_cron_cleanup_whatsapp_messages" model="ir.cron">
            <field name="name">WhatsApp: Apply Message Retention</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_message"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_old_messages()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <!-- PHASE 2: Cleanup Old API Logs (NEW) -->
        <record id="ir_cron_cleanup_api_logs" model="ir.cron">
            <field name="name">WhatsApp: Cleanup Old API Logs</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_api_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- A/B Test Winner Auto-Evaluation -->
        <record id="ir_cron_evaluate_ab_tests" model="ir.cron">
            <field name="name">WhatsApp: Evaluate A/B Test Winners</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_evaluate_ab_tests()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- PHASE 3: Process Scheduled Campaigns (NEW) -->
        <record id="ir_cron_process_scheduled_campaigns" model="ir.cron">
            <field name="name">WhatsApp: Process Scheduled Campaigns</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_scheduled_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_scheduled_campaigns()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Industrial: Reset Daily Tier Counters -->
        <record id="ir_cron_reset_daily_counters" model="ir.cron">
            <field name="name">WhatsApp: Reset Daily Tier Counters</field>
            <field name="model_id" ref="elsx_whatsapp_marketing.model_whatsapp_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_reset_daily_counters()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Invoicing: Overdue Reminders -->
        <record id="ir_cron_send_overdue_invoice_reminders" model="ir.cron">
            <field name="name">WhatsApp: Send Overdue Invoice Reminders</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
