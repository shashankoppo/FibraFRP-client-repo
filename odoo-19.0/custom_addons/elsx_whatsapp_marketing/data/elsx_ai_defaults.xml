<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="elsx_ai_provider_rules" model="elsx.ai.provider">
        <field name="name">Rules Draft Engine</field>
        <field name="sequence">1</field>
        <field name="provider_type">rules</field>
        <field name="default_model">elsx-rules-v1</field>
        <field name="request_format">custom_json</field>
        <field name="timeout_seconds">10</field>
        <field name="max_retries">0</field>
        <field name="notes">Stabilization-safe local draft engine. Does not call external AI APIs.</field>
    </record>

    <record id="elsx_ai_provider_openai_compatible" model="elsx.ai.provider">
        <field name="name">OpenAI-Compatible Provider</field>
        <field name="sequence">50</field>
        <field name="provider_type">openai</field>
        <field name="request_format">openai_chat</field>
        <field name="api_base_url">https://api.openai.com/v1</field>
        <field name="default_model">gpt-compatible-model</field>
        <field name="timeout_seconds">30</field>
        <field name="max_retries">1</field>
        <field name="notes">Set API key and model before use. Also works for compatible gateways.</field>
    </record>

    <record id="elsx_ai_provider_anthropic" model="elsx.ai.provider">
        <field name="name">Anthropic / Claude</field>
        <field name="sequence">60</field>
        <field name="provider_type">anthropic</field>
        <field name="request_format">anthropic_messages</field>
        <field name="api_base_url">https://api.anthropic.com</field>
        <field name="default_model">claude-model</field>
        <field name="response_path">content.0.text</field>
        <field name="notes">Set API key and exact Claude model before use.</field>
    </record>

    <record id="elsx_ai_provider_deepseek" model="elsx.ai.provider">
        <field name="name">DeepSeek</field>
        <field name="sequence">70</field>
        <field name="provider_type">deepseek</field>
        <field name="request_format">openai_chat</field>
        <field name="api_base_url">https://api.deepseek.com/v1</field>
        <field name="default_model">deepseek-model</field>
        <field name="notes">OpenAI-compatible endpoint. Set API key and model before use.</field>
    </record>

    <record id="elsx_ai_provider_nvidia_nim" model="elsx.ai.provider">
        <field name="name">NVIDIA NIM</field>
        <field name="sequence">80</field>
        <field name="provider_type">nvidia_nim</field>
        <field name="request_format">openai_chat</field>
        <field name="api_base_url">https://integrate.api.nvidia.com/v1</field>
        <field name="default_model">nim-model</field>
        <field name="notes">OpenAI-compatible NIM endpoint. Set API key and model before use.</field>
    </record>

    <record id="elsx_ai_provider_alibaba_qwen" model="elsx.ai.provider">
        <field name="name">Alibaba / Qwen</field>
        <field name="sequence">90</field>
        <field name="provider_type">alibaba_qwen</field>
        <field name="request_format">openai_chat</field>
        <field name="api_base_url">https://dashscope-intl.aliyuncs.com/compatible-mode/v1</field>
        <field name="default_model">qwen-model</field>
        <field name="notes">OpenAI-compatible Qwen endpoint. Set API key and model before use.</field>
    </record>

    <record id="elsx_ai_provider_huggingface" model="elsx.ai.provider">
        <field name="name">HuggingFace Inference</field>
        <field name="sequence">100</field>
        <field name="provider_type">huggingface</field>
        <field name="request_format">huggingface_inference</field>
        <field name="api_base_url">https://api-inference.huggingface.co/models/your-model</field>
        <field name="default_model">huggingface-model</field>
        <field name="response_path">0.generated_text</field>
        <field name="notes">Set API key and replace API base URL with the exact model inference URL.</field>
    </record>

    <record id="elsx_ai_provider_custom_http" model="elsx.ai.provider">
        <field name="name">Custom HTTP Provider</field>
        <field name="sequence">110</field>
        <field name="provider_type">custom</field>
        <field name="request_format">custom_json</field>
        <field name="api_key_header">Authorization</field>
        <field name="default_model">custom-model</field>
        <field name="notes">Use this for local models, internal gateways, or providers with custom JSON contracts.</field>
    </record>

    <function model="elsx.ai.prompt" name="_ensure_default_prompt">
        <value eval="'elsx_ai_prompt_whatsapp_reply'"/>
        <value eval="{
            'name': 'WhatsApp Draft Reply',
            'code': 'whatsapp_reply_default',
            'purpose': 'whatsapp_reply',
            'provider_id': ref('elsx_ai_provider_rules'),
            'system_prompt': 'Draft helpful WhatsApp replies. Never send automatically.',
            'user_prompt': 'Use the latest conversation message and produce one concise reply draft.',
        }"/>
    </function>

    <function model="elsx.ai.prompt" name="_ensure_default_prompt">
        <value eval="'elsx_ai_prompt_campaign'"/>
        <value eval="{
            'name': 'WhatsApp Campaign Draft',
            'code': 'whatsapp_campaign_default',
            'purpose': 'campaign',
            'provider_id': ref('elsx_ai_provider_rules'),
            'system_prompt': 'Draft campaign copy for WhatsApp. Keep it short, useful, and opt-in friendly.',
            'user_prompt': 'Use the campaign audience and business context to produce one campaign body draft.',
        }"/>
    </function>

    <function model="elsx.ai.prompt" name="_ensure_default_prompt">
        <value eval="'elsx_ai_prompt_template'"/>
        <value eval="{
            'name': 'WhatsApp Template Draft',
            'code': 'whatsapp_template_default',
            'purpose': 'custom',
            'provider_id': ref('elsx_ai_provider_rules'),
            'system_prompt': 'Draft WhatsApp template text. Respect Meta template quality: clear purpose, no spam tone, no unsupported claims.',
            'user_prompt': 'Create one template body draft. Do not submit or send anything.',
        }"/>
    </function>

    <function model="elsx.ai.prompt" name="_ensure_default_prompt">
        <value eval="'elsx_ai_prompt_flow_review'"/>
        <value eval="{
            'name': 'WhatsApp Flow Review',
            'code': 'whatsapp_flow_review_default',
            'purpose': 'custom',
            'provider_id': ref('elsx_ai_provider_rules'),
            'system_prompt': 'Review WhatsApp bot flows for missing routes, unclear prompts, fallback gaps, and handoff quality.',
            'user_prompt': 'Return concise admin guidance only. Do not alter the flow.',
        }"/>
    </function>
</odoo>
