<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_whatsapp_account_team_member" model="ir.rule">
        <field name="name">WhatsApp accounts: team members only</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="domain_force">['|', ('team_member_ids', '=', False), ('team_member_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <record id="rule_whatsapp_account_manager_all" model="ir.rule">
        <field name="name">WhatsApp accounts: managers all</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>

