<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elsx_whatsapp_marketing.WhatsAppPhonePreview">
        <div class="elsx-wa-phone-preview">
            <div class="elsx-wa-phone-preview__bar">
                <span class="elsx-wa-phone-preview__avatar">WA</span>
                <div class="elsx-wa-phone-preview__identity">
                    <strong>Business</strong>
                    <span>WhatsApp</span>
                </div>
            </div>
            <div class="elsx-wa-phone-preview__conversation">
                <article class="elsx-wa-phone-preview__message">
                    <t t-if="props.payload.header &amp;&amp; props.payload.header.type === 'text' &amp;&amp; props.payload.header.text">
                        <strong class="elsx-wa-phone-preview__header-text" t-esc="props.payload.header.text"/>
                    </t>
                    <t t-if="props.payload.header &amp;&amp; props.payload.header.media_url">
                        <img t-if="props.payload.header.type === 'image'"
                             class="elsx-wa-phone-preview__media"
                             t-att-src="props.payload.header.media_url"
                             alt="Template header"/>
                        <video t-elif="props.payload.header.type === 'video'"
                               class="elsx-wa-phone-preview__media"
                               t-att-src="props.payload.header.media_url"
                               controls="controls"/>
                        <div t-else="" class="elsx-wa-phone-preview__document">
                            <span>Document</span>
                            <strong t-esc="props.payload.header.filename || 'Attachment'"/>
                        </div>
                    </t>
                    <div class="elsx-wa-phone-preview__body" t-esc="props.payload.body || ''"/>
                    <div t-if="props.payload.footer" class="elsx-wa-phone-preview__footer" t-esc="props.payload.footer"/>
                    <div t-if="props.payload.buttons &amp;&amp; props.payload.buttons.length" class="elsx-wa-phone-preview__buttons">
                        <button t-foreach="props.payload.buttons"
                                t-as="button"
                                t-key="button_index"
                                type="button"
                                disabled="disabled"
                                t-esc="button.text"/>
                    </div>
                </article>
                <div t-if="props.payload.carousel &amp;&amp; props.payload.carousel.length"
                     class="elsx-wa-phone-preview__carousel">
                    <article t-foreach="props.payload.carousel"
                             t-as="card"
                             t-key="card.id || card_index"
                             class="elsx-wa-phone-preview__card">
                        <img t-if="card.header &amp;&amp; card.header.media_url &amp;&amp; card.header.type === 'image'"
                             t-att-src="card.header.media_url"
                             alt="Carousel card"/>
                        <video t-elif="card.header &amp;&amp; card.header.media_url"
                               t-att-src="card.header.media_url"
                               controls="controls"/>
                        <div class="elsx-wa-phone-preview__body" t-esc="card.body || ''"/>
                        <div class="elsx-wa-phone-preview__buttons">
                            <button t-foreach="card.buttons || []"
                                    t-as="button"
                                    t-key="button_index"
                                    type="button"
                                    disabled="disabled"
                                    t-esc="button.text"/>
                        </div>
                    </article>
                </div>
            </div>
        </div>
        <ul t-if="props.payload.warnings &amp;&amp; props.payload.warnings.length"
            class="elsx-wa-phone-preview__warnings">
            <li t-foreach="props.payload.warnings"
                t-as="warning"
                t-key="warning_index"
                t-att-class="warning.severity === 'error' ? 'text-danger' : 'text-warning'"
                t-esc="warning.message"/>
        </ul>
    </t>

    <t t-name="elsx_whatsapp_marketing.WhatsAppPhonePreviewField">
        <div class="o_field_whatsapp_phone_preview">
            <WhatsAppPhonePreview payload="payload"/>
        </div>
    </t>
</templates>
