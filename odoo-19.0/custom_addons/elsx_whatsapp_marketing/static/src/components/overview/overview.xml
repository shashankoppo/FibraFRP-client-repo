<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elsx_whatsapp_marketing.WhatsAppOverviewV2">
        <div class="o_action elsx-wa-overview">
            <header class="elsx-wa-overview__toolbar">
                <div>
                    <h1>WhatsApp Overview</h1>
                    <span t-att-class="state.data.runtime_enabled ? 'text-success' : 'text-danger'">
                        <t t-esc="state.data.runtime_enabled ? 'Runtime active' : 'Runtime paused'"/>
                    </span>
                </div>
                <button type="button"
                        class="btn btn-secondary"
                        t-on-click="load"
                        title="Refresh">
                    <i class="fa fa-refresh" aria-hidden="true"/>
                    <span>Refresh</span>
                </button>
            </header>

            <div t-if="state.loading" class="elsx-wa-overview__state">
                <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                <span>Loading</span>
            </div>
            <div t-elif="state.error" class="elsx-wa-overview__state text-danger">
                <span>Overview unavailable</span>
                <button type="button" class="btn btn-secondary" t-on-click="load">Retry</button>
            </div>
            <main t-else="" class="elsx-wa-overview__content">
                <section class="elsx-wa-overview__metrics">
                    <button type="button"
                            class="elsx-wa-overview__metric"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_team_inbox')">
                        <span>Needs reply</span>
                        <strong t-esc="state.data.metrics.needs_reply || 0"/>
                    </button>
                    <button type="button"
                            class="elsx-wa-overview__metric"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_team_inbox')">
                        <span>Unassigned</span>
                        <strong t-esc="state.data.metrics.unassigned || 0"/>
                    </button>
                    <button type="button"
                            class="elsx-wa-overview__metric"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_message')">
                        <span>Failed today</span>
                        <strong t-esc="state.data.metrics.failed_messages || 0"/>
                    </button>
                    <button type="button"
                            class="elsx-wa-overview__metric"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_campaign')">
                        <span>Active campaigns</span>
                        <strong t-esc="state.data.metrics.active_campaigns || 0"/>
                    </button>
                </section>

                <section class="elsx-wa-overview__exceptions">
                    <div class="elsx-wa-overview__section-title">
                        <h2>Exceptions</h2>
                    </div>
                    <button t-foreach="state.data.exceptions"
                            t-as="item"
                            t-key="item.code"
                            type="button"
                            t-att-class="'elsx-wa-overview__exception elsx-wa-overview__exception--' + item.level"
                            t-att-disabled="!item.action"
                            t-on-click="() => this.open(item.action)">
                        <span t-esc="item.title"/>
                        <i t-if="item.action" class="fa fa-chevron-right" aria-hidden="true"/>
                    </button>
                </section>

                <section class="elsx-wa-overview__commands">
                    <button type="button"
                            class="btn btn-primary"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_team_inbox')">
                        <i class="fa fa-comments" aria-hidden="true"/>
                        <span>Open Inbox</span>
                    </button>
                    <button type="button"
                            class="btn btn-secondary"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_campaign_wizard')">
                        <i class="fa fa-bullhorn" aria-hidden="true"/>
                        <span>Create Campaign</span>
                    </button>
                    <button type="button"
                            class="btn btn-secondary"
                            t-on-click="() => this.open('elsx_whatsapp_marketing.action_whatsapp_template')">
                        <i class="fa fa-file-text-o" aria-hidden="true"/>
                        <span>Templates</span>
                    </button>
                </section>
            </main>
        </div>
    </t>
</templates>
