<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Account Tree View -->
    <record id="view_whatsapp_account_tree" model="ir.ui.view">
        <field name="name">whatsapp.account.tree</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="status" decoration-success="status=='connected'" decoration-danger="status=='error'"/>
                <field name="message_count"/>
                <field name="campaign_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- WhatsApp Account Form View -->
    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="action_perform_api_test_calls" string="Perform Meta Test Calls" type="object" class="btn-info" icon="fa-vial"/>
                    <button name="action_test_sidecar" string="Test Sidecar" type="object" class="btn-secondary" icon="fa-heartbeat"/>
                    <button name="action_sync_templates" string="Sync Templates" type="object" class="btn-secondary" icon="fa-refresh" invisible="status != 'connected'"/>
                    <button name="action_create_sample_templates" string="Load Sample Templates" type="object" class="btn-secondary" icon="fa-magic"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <field name="sandbox_warning" invisible="not is_sandbox"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_whatsapp_message)d" type="action" class="oe_stat_button" icon="fa-comments">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                        <button name="%(action_whatsapp_campaign)d" type="action" class="oe_stat_button" icon="fa-bullhorn">
                            <field name="campaign_count" widget="statinfo" string="Campaigns"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Account Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Account Details">
                            <field name="phone_number"/>
                            <field name="phone_number_id"/>
                            <field name="business_account_id"/>
                            <field name="api_version"/>
                            <field name="active"/>
                        </group>
                        <group string="API Configuration">
                            <field name="access_token" password="True"/>
                            <field name="is_sandbox"/>
                            <field name="two_factor_pin" password="1"/>
                            <button name="action_register_phone" string="Register Phone" type="object" class="oe_highlight"/>
                            <field name="webhook_url" readonly="1"/>
                            <field name="webhook_verify_token"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business Profile" name="business_profile">
                            <header>
                                <button name="action_get_business_profile" string="Sync from Meta" type="object" class="btn-secondary" icon="fa-refresh"/>
                                <button name="action_update_business_profile" string="Save to Meta" type="object" class="btn-primary" icon="fa-cloud-upload"/>
                            </header>
                            <group>
                                <group string="Public Info">
                                    <field name="business_description" placeholder="Business description / About"/>
                                    <field name="business_vertical"/>
                                    <div class="o_td_label">
                                        <label for="profile_image" string="Profile Picture"/>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <field name="profile_image" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                                        <button name="action_sync_profile_picture" string="Refresh Picture" type="object" class="btn-xs btn-outline-primary" icon="fa-camera" invisible="status != 'connected'"/>
                                    </div>
                                </group>
                                <group string="Account Health">
                                    <field name="quality_rating" decoration-success="quality_rating == 'GREEN'" decoration-warning="quality_rating == 'YELLOW'" decoration-danger="quality_rating == 'RED'"/>
                                    <field name="messaging_limit"/>
                                </group>
                                <group string="Contact Details">
                                    <field name="business_email" widget="email"/>
                                    <field name="business_address"/>
                                    <field name="business_websites" placeholder="https://example.com, https://blog.example.com"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert">
                                <i class="fa fa-info-circle me-1" title="Information"/> 
                                Changes made here will be visible to your customers on WhatsApp once you click <strong>Save to Meta</strong>.
                            </div>
                        </page>
                        <page string="Automation &amp; AI" name="automation_ai">
                            <group>
                                <group string="Traditional Auto-Reply">
                                    <field name="auto_reply_enabled"/>
                                    <field name="auto_reply_message" invisible="not auto_reply_enabled"/>
                                </group>
                                <group string="AI Smart Assistant">
                                    <field name="ai_enabled"/>
                                    <field name="ai_model" invisible="not ai_enabled"/>
                                </group>
                            </group>
                            <group string="AI Business Context" invisible="not ai_enabled">
                                <field name="ai_context" placeholder="Example: We are an e-commerce store selling premium coffee beans. Our shipping policy is 2-3 business days. We offer free returns within 30 days..."/>
                            </group>
                        </page>
                        <page string="Notification Settings" name="notification_settings">
                            <group>
                                <field name="notification_enabled"/>
                                <field name="notification_sound_receive"/>
                                <field name="notification_sound_send"/>
                            </group>
                        </page>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="phone_number"/>
                                    <field name="direction"/>
                                    <field name="message_type"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="API Test Panel" name="api_test">
                            <group>
                                <group string="Send Test Message">
                                    <field name="test_phone_number" placeholder="e.g. 919876543210"/>
                                    <field name="test_message_body" placeholder="Write something to test..."/>
                                    <button name="action_send_test_message" string="Execute Test API Call" type="object" class="btn-primary" icon="fa-paper-plane"/>
                                </group>
                                <group string="Test Results">
                                    <field name="test_api_status" widget="badge" decoration-success="test_api_status == 'success'" decoration-danger="test_api_status == 'failed'" decoration-info="test_api_status == 'none'"/>
                                    <field name="test_api_response" widget="text" style="font-family: monospace; font-size: 0.8rem;"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-2" role="alert">
                                <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                                <strong>Note:</strong> Sending a test message will consume your Meta messaging quota. If in <strong>Sandbox Mode</strong>, ensure the recipient is a registered test number in the Meta Developer Portal.
                            </div>
                        </page>
                        <page string="Webhook &amp; Advanced" name="webhook_advanced">
                            <group>
                                <group string="Webhook Health">
                                    <field name="webhook_url" readonly="1" widget="copy_clipboard"/>
                                    <field name="webhook_verify_token" password="True"/>
                                    <field name="webhook_status" widget="badge" 
                                           decoration-success="webhook_status == 'verified'" 
                                           decoration-danger="webhook_status == 'failed'" 
                                           decoration-info="webhook_status == 'none'"/>
                                    <field name="webhook_last_error" invisible="not webhook_last_error" class="text-danger fw-bold"/>
                                </group>
                                <group string="Enterprise Reliability">
                                    <field name="app_secret" password="True"/>
                                    <field name="is_primary_webhook_db"/>
                                    <field name="skip_webhook_hmac"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert" invisible="not skip_webhook_hmac">
                                <i class="fa fa-warning me-1" title="Warning"/>
                                <strong>Debug Mode:</strong> Signature verification is disabled. Do not use this in production.
                            </div>
                        </page>
                        <page string="Campaigns" name="campaigns">
                            <field name="campaign_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="campaign_type"/>
                                    <field name="state"/>
                                    <field name="total_recipients"/>
                                    <field name="sent_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Account Action -->
    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Business Account
            </p>
            <p>
                Connect your WhatsApp Business API account to start sending messages and campaigns.
            </p>
        </field>
    </record>
</odoo>
