<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Media Library Views -->
    <record id="whatsapp_media_library_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.media.library.tree</field>
        <field name="model">whatsapp.media.library</field>
        <field name="arch" type="xml">
            <list string="Media Library">
                <field name="name"/>
                <field name="media_type"/>
                <field name="category"/>
                <field name="file_size"/>
                <field name="usage_count"/>
                <field name="upload_status"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_media_library_view_form" model="ir.ui.view">
        <field name="name">whatsapp.media.library.form</field>
        <field name="model">whatsapp.media.library</field>
        <field name="arch" type="xml">
            <form string="Media File">
                <header>
                    <button name="action_upload_to_meta" type="object" string="Upload to Meta" 
                            class="btn-primary" invisible="upload_status == 'uploaded'"/>
                    <button name="action_use_in_message" type="object" string="Use in Message"/>
                    <button name="action_bulk_use" type="object" string="Send to Contacts"/>
                    <field name="upload_status" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Media Name"/>
                    </h1>
                    <div class="row">
                        <div class="col-6">
                            <field name="account_id" required="1"/>
                            <field name="media_type" required="1"/>
                            <field name="category"/>
                        </div>
                        <div class="col-6">
                            <field name="file_size" readonly="1"/>
                            <field name="mime_type" readonly="1"/>
                            <field name="usage_count" readonly="1"/>
                        </div>
                    </div>
                    
                    <field name="description" placeholder="Describe this media..."/>
                    
                    <group string="Media File">
                        <field name="media_file" filename="media_filename" required="1"/>
                        <field name="media_filename"/>
                    </group>
                    
                    <group string="Meta Integration" invisible="upload_status != 'uploaded'">
                        <field name="media_id" readonly="1"/>
                        <field name="media_url" readonly="1"/>
                        <field name="uploaded_date" readonly="1"/>
                    </group>
                    
                    <group string="Organization">
                        <field name="tag_ids" nolabel="1" widget="many2many_tags"/>
                        <field name="is_reusable"/>
                        <field name="expiry_date"/>
                        <field name="active"/>
                    </group>
                    
                    <field name="error_message" invisible="not error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_media_library_action" model="ir.actions.act_window">
        <field name="name">Media Library</field>
        <field name="res_model">whatsapp.media.library</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload media files to reuse in messages
            </p>
        </field>
    </record>

    <!-- Menu Item -->

</odoo>
