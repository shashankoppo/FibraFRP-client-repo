<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Segment Views -->
    <record id="whatsapp_contact_segment_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.contact.segment.tree</field>
        <field name="model">whatsapp.contact.segment</field>
        <field name="arch" type="xml">
            <list string="Contact Segments">
                <field name="name"/>
                <field name="account_id"/>
                <field name="segment_type"/>
                <field name="contact_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_contact_segment_view_form" model="ir.ui.view">
        <field name="name">whatsapp.contact.segment.form</field>
        <field name="model">whatsapp.contact.segment</field>
        <field name="arch" type="xml">
            <form string="Contact Segment" class="o_whatsapp_segment_form">
                <header>
                    <button name="action_refresh_contacts" type="object" string="Refresh Contacts" class="btn-secondary"/>
                    <button name="action_send_campaign" type="object" string="Send Campaign" class="btn-primary"/>
                    <button name="action_add_contacts" type="object" string="Add Contacts" invisible="segment_type != 'manual'"/>
                </header>
                <sheet>
                    <h1><field name="name" placeholder="Segment Name"/></h1>
                    <div class="row">
                        <div class="col-6">
                            <field name="account_id" required="1"/>
                            <field name="segment_type"/>
                        </div>
                        <div class="col-6">
                            <field name="contact_count"/>
                            <field name="active"/>
                        </div>
                    </div>
                    
                    <field name="description" placeholder="Describe this segment..."/>
                    <div class="alert alert-info" role="alert" invisible="segment_type not in ['smart_valid_contacts', 'smart_highly_engaged', 'smart_winback', 'smart_at_risk', 'smart_opted_out', 'smart_no_recent_reply']">
                        Smart segments are recalculated from WhatsApp opt-in state, message history, and recent replies when you click Refresh Contacts.
                    </div>
                    
                    <group string="Manual Audience" invisible="segment_type != 'manual'">
                        <field name="manual_contact_ids" widget="many2many_tags" domain="[('phone', '!=', False)]"/>
                    </group>

                    <group string="Segmentation Criteria" invisible="segment_type in ['manual', 'smart_valid_contacts', 'smart_highly_engaged', 'smart_winback', 'smart_at_risk', 'smart_opted_out', 'smart_no_recent_reply']">
                        <group invisible="segment_type != 'auto_tag'">
                            <field name="tag_ids" widget="many2many_tags" string="Any Tags"/>
                            <field name="tag_all_ids" widget="many2many_tags" string="All Tags"/>
                            <field name="tag_exclude_ids" widget="many2many_tags" string="Exclude Tags"/>
                        </group>
                        <group invisible="segment_type != 'behavior'">
                            <field name="min_message_count"/>
                            <field name="max_message_count"/>
                            <field name="last_message_days"/>
                            <field name="engagement_level"/>
                        </group>
                        <group invisible="segment_type != 'demographics'">
                            <field name="country_code"/>
                            <field name="gender"/>
                            <field name="min_age"/>
                            <field name="max_age"/>
                        </group>
                        <group invisible="segment_type != 'revenue'">
                            <field name="min_lifetime_value"/>
                            <field name="max_lifetime_value"/>
                        </group>
                        <group invisible="segment_type != 'custom_filter'">
                            <field name="domain_filter" nolabel="1"/>
                        </group>
                    </group>
                    
                    <separator string="Contacts"/>
                    <field name="contact_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_contact_segment_action" model="ir.actions.act_window">
        <field name="name">Contact Segments</field>
        <field name="res_model">whatsapp.contact.segment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contact segment
            </p>
        </field>
    </record>

    <!-- Menu Item -->

</odoo>
