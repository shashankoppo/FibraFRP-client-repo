<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Campaign Tree View -->
    <record id="view_whatsapp_campaign_tree" model="ir.ui.view">
        <field name="name">whatsapp.campaign.tree</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Campaigns" decoration-success="state=='completed'" decoration-info="state=='running'" decoration-muted="state=='archived'">
                <field name="name"/>
                <field name="account_id"/>
                <field name="campaign_type"/>
                <field name="total_recipients"/>
                <field name="queued_count"/>
                <field name="sent_count"/>
                <field name="delivered_count"/>
                <field name="read_count"/>
                <field name="delivery_rate" widget="percentage"/>
                <field name="read_rate" widget="percentage"/>
                <field name="roi" widget="percentage"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- WhatsApp Campaign Form View -->
    <record id="view_whatsapp_campaign_form" model="ir.ui.view">
        <field name="name">whatsapp.campaign.form</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Campaign" class="o_whatsapp_campaign_form">
                <header>
                    <button name="action_load_recipients" string="Load Recipients" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_generate_ai_content" string="Draft Content" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="%(elsx_whatsapp_marketing.action_whatsapp_campaign_schedule_wizard)d" string="Schedule / Send" type="action" class="btn-primary" invisible="state != 'draft'" context="{'default_campaign_id': id}"/>
                    <button name="action_process_queue" string="Process Queue (Send 50)" type="object" class="btn-warning" invisible="state != 'running'"/>
                    <button name="action_retry_failed_messages" string="Retry Failed" type="object" class="btn-secondary" invisible="failed_count == 0"/>
                    <button name="action_view_failed_recipients" string="Failed Recipients" type="object" class="btn-secondary" invisible="failed_count == 0"/>
                    <button name="action_export_failed_recipients" string="Export Failed" type="object" class="btn-secondary" invisible="failed_count == 0"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="state in ['completed', 'cancelled', 'archived']"/>
                    <button name="action_archive_record" string="Archive" type="object" class="btn-secondary" invisible="state == 'archived'"/>
                    <button name="action_unarchive_record" string="Unarchive" type="object" class="btn-primary" invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Campaign Name"/>
                        </h1>
                    </div>
                    <!-- Smart Stats Dashboard -->
                    <div class="wa-kpi-grid mb-4">
                        <div class="wa-kpi-card">
                            <span>Queued</span>
                            <strong><field name="queued_count" readonly="1"/></strong>
                        </div>
                        <div class="wa-kpi-card">
                            <span>Sent</span>
                            <strong><field name="sent_count" readonly="1"/></strong>
                        </div>
                        <div class="wa-kpi-card">
                            <span>Delivered</span>
                            <strong><field name="delivery_rate" widget="percentage" readonly="1"/></strong>
                        </div>
                        <div class="wa-kpi-card">
                            <span>Read</span>
                            <strong><field name="read_rate" widget="percentage" readonly="1"/></strong>
                        </div>
                        <div class="wa-kpi-card">
                            <span>ROI</span>
                            <strong><field name="roi" widget="percentage" readonly="1"/></strong>
                        </div>
                        <div class="wa-kpi-card">
                            <span>Replies</span>
                            <strong><field name="tracked_reply_count" readonly="1"/></strong>
                        </div>
                    </div>

                    <group>
                        <group string="Campaign Settings">
                            <field name="account_id"/>
                            <field name="campaign_type"/>
                            <field name="schedule_type"/>
                            <field name="schedule_date" invisible="schedule_type == 'immediate'" required="schedule_type == 'scheduled'"/>
                        </group>
                        <group string="Enterprise Logistics">
                            <field name="batch_size"/>
                            <field name="batch_interval"/>
                            <field name="flow_id" options="{'no_create': True}"/>
                            <field name="form_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Configuration">
                            <field name="target_type"/>
                            <field name="total_recipients" readonly="1"/>
                            <field name="queued_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Pre-send Checklist">
                        <div class="alert alert-light border mb-0" role="status">
                            <field name="pre_send_checklist_text" nolabel="1" readonly="1" class="wa-campaign-checklist-text"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="Recipients" name="recipients">
                            <group>
                                <field name="target_type"/>
                                <field name="segment_id" invisible="target_type != 'segment'" required="target_type == 'segment' and not domain_filter"/>
                                <field name="domain_filter" invisible="target_type != 'segment'" required="target_type == 'segment' and not segment_id"/>
                                <field name="crm_stage_id" invisible="target_type != 'crm_stage'"/>
                                <field name="tag_ids" widget="many2many_tags" invisible="target_type != 'tags'" required="target_type == 'tags'"/>
                                <field name="csv_filename" invisible="1"/>
                                <field name="csv_file" filename="csv_filename" invisible="target_type != 'csv'" required="target_type == 'csv'" string="Upload Audience CSV" help="Upload a CSV with 'Phone' and 'Name' columns"/>
                            </group>
                            <group string="Suppression &amp; Frequency Caps">
                                <field name="exclude_recently_contacted"/>
                                <field name="recent_contact_days" invisible="not exclude_recently_contacted"/>
                                <field name="frequency_cap_days"/>
                                <field name="excluded_count" readonly="1"/>
                                <field name="exclusion_notes" readonly="1" nolabel="1" placeholder="Load recipients to see exclusion summary."/>
                            </group>
                            <field name="partner_ids" required="target_type == 'manual'">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tracking &amp; Conversions" name="tracking_conversions">
                            <div class="alert alert-info" role="alert">
                                Generate a wa.me entry link for click-to-WhatsApp ads or website CTAs. V1 tracks the source when the customer sends the entry keyword; it does not create Meta ads.
                            </div>
                            <group>
                                <group string="Entry Link">
                                    <field name="tracking_source"/>
                                    <field name="tracking_medium"/>
                                    <field name="tracking_campaign_code"/>
                                    <field name="tracking_entry_keyword"/>
                                    <button name="action_generate_tracking_keyword" type="object" string="Generate Keyword" class="btn-secondary"/>
                                    <field name="tracking_wa_link" readonly="1" widget="copy_clipboard"/>
                                </group>
                                <group string="Conversion Counters">
                                    <field name="form_submission_count" readonly="1"/>
                                    <field name="payment_action_count" readonly="1"/>
                                    <field name="tracked_reply_count" readonly="1"/>
                                </group>
                            </group>
                            <group string="Campaign Form">
                                <field name="form_id" options="{'no_create': True}"/>
                                <div class="alert alert-warning" role="alert" colspan="2">
                                    Form links save submissions for review first. Users can manually create leads from submissions.
                                </div>
                            </group>
                        </page>
                        <page string="Drip Steps" name="drip_steps" invisible="campaign_type != 'drip'">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="delay_unit" string="After"/>
                                    <field name="delay_type" string="Unit"/>
                                    <field name="template_id" domain="[('account_id', '=', parent.account_id), ('status', '=', 'approved')]" options="{'no_create': True}"/>
                                    <field name="condition_type"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                    <group string="Timing &amp; Content">
                                        <field name="delay_unit"/>
                                        <field name="delay_type"/>
                                        <field name="template_id" domain="[('account_id', '=', parent.account_id), ('status', '=', 'approved')]" options="{'no_create': True}" required="not message_body"/>
                                        <field name="message_body" widget="text" invisible="template_id" required="not template_id"/>
                                    </group>
                                    <group string="Condition">
                                        <field name="condition_type"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Message" name="message" invisible="campaign_type == 'drip'">
                            <field name="template_header_type" invisible="1"/>
                            <group invisible="is_ab_test">
                                <field name="template_id" domain="[('account_id', '=', account_id), ('status', '=', 'approved')]" options="{'no_create': True}" required="not message_body"/>
                                <field name="message_body" widget="text" placeholder="Use {{name}} and {{company}} for personalization" invisible="template_id" required="not template_id"/>
                            </group>
                            <group string="Template Header Media Override" invisible="is_ab_test or not template_id or template_header_type not in ['image', 'video', 'document']">
                                <div class="alert alert-warning" role="alert" colspan="2">
                                    This template has a media header. Add a file or public URL here when this campaign needs a campaign-specific catalogue, image, video, or document.
                                </div>
                                <field name="template_header_media_file" filename="template_header_media_filename"/>
                                <field name="template_header_media_filename" invisible="1"/>
                                <field name="template_header_media_url" placeholder="https://example.com/catalogue.pdf or Meta media ID"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Personalization:</strong>
                                Use <code>{{name}}</code>, <code>{{company}}</code>, and the Configuration &gt; Placeholder Guide for supported fields. Click Draft Content for an AI draft; it is never sent until you schedule/send.
                            </div>
                            <group string="AI Draft Review" invisible="not ai_variant_a and not ai_audience_warning">
                                <field name="ai_spam_risk" readonly="1"/>
                                <field name="ai_audience_warning" readonly="1"/>
                                <field name="ai_reply_rule_suggestions" readonly="1"/>
                                <field name="ai_variant_a" readonly="1"/>
                                <field name="ai_variant_b" readonly="1"/>
                            </group>
                            <group string="Per-recipient Preview">
                                <field name="preview_partner_id" domain="[('id', 'in', partner_ids)]"/>
                                <div class="alert alert-light border" role="status" colspan="2">
                                    <div class="fw-bold text-muted text-uppercase small mb-2">Customer Preview Checklist</div>
                                    <field name="recipient_preview_text" nolabel="1" readonly="1" class="wa-safe-preview-text"/>
                                </div>
                            </group>
                        </page>
                        <page string="Reply Actions" name="reply_actions">
                            <group>
                                <button name="action_sync_template_reply_buttons" string="Sync Template Buttons" type="object" class="btn-secondary" invisible="not template_id"/>
                            </group>
                            <group string="Default Free-text Reply">
                                <field name="default_reply_action"/>
                                <field name="reply_flow_id" invisible="default_reply_action != 'start_flow'" options="{'no_create': True}"/>
                                <field name="reply_response_message" invisible="default_reply_action != 'send_message'" placeholder="Thanks {{name}}, our team will reply shortly."/>
                                <field name="reply_form_id" invisible="default_reply_action != 'send_form_link'" options="{'no_create': True}" placeholder="Leave empty to use Campaign Form or Account Default Form"/>
                                <field name="reply_assign_user_id" invisible="default_reply_action != 'assign_user'"/>
                                <field name="reply_assign_team_member_id" invisible="default_reply_action != 'assign_team_member'" options="{'no_create': True}"/>
                                <field name="reply_assign_tag_id" invisible="default_reply_action != 'assign_tag'"/>
                                <field name="reply_chat_status" invisible="default_reply_action != 'set_chat_status'"/>
                                <field name="reply_lead_note" invisible="default_reply_action != 'update_lead_note'" placeholder="Lead note can use {{name}}, {{phone}}, and {{last_reply}}."/>
                            </group>
                            <field name="reply_rule_ids" context="{'default_campaign_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="active"/>
                                    <field name="name"/>
                                    <field name="match_type"/>
                                    <field name="match_value"/>
                                    <field name="action_type"/>
                                    <field name="flow_id" invisible="action_type != 'start_flow'"/>
                                    <field name="form_id" invisible="action_type != 'send_form_link'"/>
                                    <field name="response_message" invisible="action_type != 'send_message'"/>
                                    <field name="assign_user_id" invisible="action_type != 'assign_user'"/>
                                    <field name="assign_team_member_id" invisible="action_type != 'assign_team_member'"/>
                                    <field name="assign_tag_id" invisible="action_type != 'assign_tag'"/>
                                    <field name="chat_status" invisible="action_type != 'set_chat_status'"/>
                                    <field name="lead_note" invisible="action_type != 'update_lead_note'"/>
                                    <field name="handled_count" readonly="1"/>
                                </list>
                                <form string="Campaign Reply Action">
                                    <group>
                                        <group string="Match">
                                            <field name="active"/>
                                            <field name="sequence"/>
                                            <field name="name"/>
                                            <field name="match_type"/>
                                            <field name="match_value" invisible="match_type == 'any_reply'"/>
                                        </group>
                                        <group string="Action">
                                            <field name="action_type"/>
                                            <field name="flow_id" invisible="action_type != 'start_flow'" options="{'no_create': True}"/>
                                            <field name="form_id" invisible="action_type != 'send_form_link'" options="{'no_create': True}"/>
                                            <field name="response_message" invisible="action_type != 'send_message'"/>
                                            <field name="assign_user_id" invisible="action_type != 'assign_user'"/>
                                            <field name="assign_team_member_id" invisible="action_type != 'assign_team_member'" options="{'no_create': True}"/>
                                            <field name="assign_tag_id" invisible="action_type != 'assign_tag'"/>
                                            <field name="chat_status" invisible="action_type != 'set_chat_status'"/>
                                            <field name="lead_note" invisible="action_type != 'update_lead_note'" placeholder="Add this note to the existing or newly created CRM lead."/>
                                            <field name="handled_count" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Messages" name="messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="partner_id"/>
                                    <field name="phone_number"/>
                                    <field name="direction"/>
                                    <field name="message_type"/>
                                    <field name="body"/>
                                    <field name="button_text" optional="hide"/>
                                    <field name="list_item_title" optional="hide"/>
                                    <field name="media_filename" optional="hide"/>
                                    <field name="status"/>
                                    <field name="sent_date"/>
                                    <field name="delivered_date"/>
                                    <field name="read_date"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="current_step_id"/>
                                    <field name="next_execution_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="A/B Testing" name="ab_testing" invisible="campaign_type == 'drip'">
                            <field name="template_header_type" invisible="1"/>
                            <field name="template_b_header_type" invisible="1"/>
                            <group>
                                <field name="is_ab_test"/>
                            </group>
                            <group invisible="not is_ab_test">
                                <group string="Version A (Standard)">
                                    <field name="split_percentage"/>
                                    <field name="template_id" domain="[('account_id', '=', account_id), ('status', '=', 'approved')]" options="{'no_create': True}" required="not message_body"/>
                                    <field name="message_body" widget="text" invisible="template_id" required="not template_id"/>
                                    <group string="Header Media Override" invisible="not template_id or template_header_type not in ['image', 'video', 'document']">
                                        <field name="template_header_media_file" filename="template_header_media_filename"/>
                                        <field name="template_header_media_filename" invisible="1"/>
                                        <field name="template_header_media_url" placeholder="https://example.com/catalogue.pdf or Meta media ID"/>
                                    </group>
                                </group>
                                <group string="Version B">
                                    <label for="split_percentage" string="Split B %"/>
                                    <div class="o_row">
                                        <span class="oe_grey">Auto-calculated: </span>
                                        <field name="split_percentage_b" class="fw-bold"/>
                                        <span class="fw-bold">%</span>
                                    </div>
                                    <field name="template_id_b" domain="[('account_id', '=', account_id), ('status', '=', 'approved')]" options="{'no_create': True}" required="not message_body_b"/>
                                    <field name="message_body_b" widget="text" invisible="template_id_b" required="not template_id_b"/>
                                    <group string="Header Media Override (B)" invisible="not template_id_b or template_b_header_type not in ['image', 'video', 'document']">
                                        <field name="template_b_header_media_file" filename="template_b_header_media_filename"/>
                                        <field name="template_b_header_media_filename" invisible="1"/>
                                        <field name="template_b_header_media_url" placeholder="https://example.com/catalogue-b.pdf or Meta media ID"/>
                                    </group>
                                </group>
                            </group>
                            <group string="Results" invisible="not is_ab_test or state == 'draft'">
                                <field name="ab_test_winner"/>
                            </group>
                        </page>
                        <page string="Analytics" name="analytics">
                            <group>
                                <group>
                                    <field name="click_count"/>
                                    <field name="conversion_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Campaign Kanban View -->
    <record id="view_whatsapp_campaign_kanban" model="ir.ui.view">
        <field name="name">whatsapp.campaign.kanban</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="campaign_type"/>
                <field name="state"/>
                <field name="total_recipients"/>
                <field name="queued_count"/>
                <field name="sent_count"/>
                <field name="delivered_count"/>
                <field name="read_count"/>
                <field name="read_rate"/>
                <field name="roi"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill o_whatsapp_campaign_kanban">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fw-bold fs-5"><field name="name"/></strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_body">
                                <div class="d-flex align-items-center mb-2">
                                    <span t-attf-class="badge rounded-pill me-2 #{record.campaign_type.raw_value == 'broadcast' ? 'bg-primary' : 'bg-info'}">
                                        <field name="campaign_type"/>
                                    </span>
                                    <span class="text-muted small"><i class="fa fa-users me-1" title="Recipients"/> <field name="total_recipients"/> Recipients</span>
                                </div>
                                
                                <div class="row g-1 text-center mt-3">
                                    <div class="col-4">
                                        <div class="bg-light rounded p-1">
                                            <div class="small fw-bold text-dark"><field name="queued_count"/></div>
                                            <div class="text-muted" style="font-size: 0.65rem;">Queued</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-light rounded p-1">
                                            <div class="small fw-bold text-success"><field name="sent_count"/></div>
                                            <div class="text-muted" style="font-size: 0.65rem;">Sent</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-light rounded p-1">
                                            <div class="small fw-bold text-info"><field name="read_rate" widget="percentage"/></div>
                                            <div class="text-muted" style="font-size: 0.65rem;">Read</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WhatsApp Campaign Action -->
    <record id="view_whatsapp_campaign_search" model="ir.ui.view">
        <field name="name">whatsapp.campaign.search</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Campaigns">
                <field name="name"/>
                <field name="account_id"/>
                <field name="state"/>
                <field name="campaign_type"/>
                <filter name="active_records" string="Active" domain="[('state', '!=', 'archived')]"/>
                <filter name="archived_records" string="Archived" domain="[('state', '=', 'archived')]"/>
                <filter name="draft_campaigns" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="running_campaigns" string="Running" domain="[('state', '=', 'running')]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'campaign_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_campaign" model="ir.actions.act_window">
        <field name="name">WhatsApp Campaigns</field>
        <field name="res_model">whatsapp.campaign</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_whatsapp_campaign_search"/>
        <field name="context">{'search_default_active_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Campaign
            </p>
            <p>
                Send targeted WhatsApp messages to your contacts and track performance.
            </p>
        </field>
    </record>

    <record id="action_whatsapp_campaign_archived" model="ir.actions.act_window">
        <field name="name">Archived Campaigns</field>
        <field name="res_model">whatsapp.campaign</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_whatsapp_campaign_search"/>
        <field name="context">{'search_default_archived_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No archived campaigns</p>
            <p>Archived campaigns appear here so users can open them and click Unarchive.</p>
        </field>
    </record>
</odoo>
