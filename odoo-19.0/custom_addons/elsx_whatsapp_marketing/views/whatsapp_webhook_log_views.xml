<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================
         Webhook Event Log Views
         ======================================================== -->

    <record id="view_whatsapp_webhook_log_list" model="ir.ui.view">
        <field name="name">whatsapp.webhook.log.list</field>
        <field name="model">whatsapp.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Webhook Events" decoration-danger="status == 'error'" decoration-muted="status == 'ignored'">
                <field name="create_date" string="Received At" optional="show"/>
                <field name="event_type" string="Event"/>
                <field name="account_id" optional="show"/>
                <field name="phone_number" optional="show"/>
                <field name="message_id" string="WAMID" optional="hide"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'processed'"
                    decoration-danger="status == 'error'"
                    decoration-warning="status == 'received'"
                    decoration-info="status == 'ignored'"/>
                <field name="error_detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_webhook_log_form" model="ir.ui.view">
        <field name="name">whatsapp.webhook.log.form</field>
        <field name="model">whatsapp.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Event" create="false" edit="false">
                <header>
                    <button name="action_replay" type="object" string="Replay Webhook" class="btn-primary"
                            invisible="event_type != 'waba_webhook' or status == 'processed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="event_type"/> — <field name="status" widget="badge"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="phone_number"/>
                            <field name="message_id" string="WAMID"/>
                            <field name="create_date" string="Received At"/>
                        </group>
                        <group>
                            <field name="field_type" string="Webhook Field"/>
                            <field name="error_detail" invisible="not error_detail"/>
                        </group>
                    </group>
                    <group string="Raw Payload">
                        <field name="raw_payload" widget="code" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_webhook_log_search" model="ir.ui.view">
        <field name="name">whatsapp.webhook.log.search</field>
        <field name="model">whatsapp.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="event_type" string="Event Type"/>
                <field name="phone_number"/>
                <field name="message_id" string="WAMID"/>
                <filter string="Errors" name="errors" domain="[('status','=','error')]"/>
                <separator/>
                <group>
                    <filter string="Event Type" name="group_event" context="{'group_by': 'event_type'}"/>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_webhook_logs" model="ir.actions.act_window">
        <field name="name">Webhook Event Log</field>
        <field name="res_model">whatsapp.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_whatsapp_webhook_log_search"/>
    </record>

</odoo>
