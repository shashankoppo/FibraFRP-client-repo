<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Direct Client Action for Zero-Latency Dashboard Rendering -->
    <record id="action_whatsapp_dashboard_client" model="ir.actions.client">
        <field name="name">WhatsApp Analytics Dashboard</field>
        <field name="tag">whatsapp_marketing_dashboard</field>
    </record>

    <!-- Kept for backward compatibility -->
    <record id="action_whatsapp_dashboard_server" model="ir.actions.server">
        <field name="name">WhatsApp Dashboard (Legacy)</field>
        <field name="model_id" ref="model_whatsapp_analytics"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.client',
    'tag': 'whatsapp_marketing_dashboard',
    'name': 'WhatsApp Analytics Dashboard',
}
        </field>
    </record>

</odoo>
