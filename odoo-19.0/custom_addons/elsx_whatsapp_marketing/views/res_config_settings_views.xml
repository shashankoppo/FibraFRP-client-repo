<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp Marketing" string="WhatsApp Marketing" name="elsx_whatsapp_marketing" groups="base.group_system">
                    <block title="Real-Time Engine (Sidecar)" id="whatsapp_sidecar_setting">
                        <setting id="whatsapp_sidecar_url_setting" help="URL of the Node.js WebSocket server for zero-latency messaging.">
                            <field name="whatsapp_sidecar_url" placeholder="http://node_sidecar:3000"/>
                        </setting>
                        <setting id="whatsapp_sidecar_secret_setting" help="Security token used to authenticate webhook relays between Odoo and the Sidecar.">
                            <field name="whatsapp_sidecar_secret" password="True"/>
                        </setting>
                    </block>

                    <block title="General Configuration" id="whatsapp_general_setting">
                        <setting id="whatsapp_default_account_setting" help="Default account for sending messages if not explicitly set.">
                            <field name="whatsapp_default_account_id"/>
                        </setting>
                    </block>

                    <block title="Automation &amp; Bots" id="whatsapp_automation_setting">
                        <setting id="whatsapp_enable_bot_setting" help="Process incoming messages through the visual Flow Builder and Bot Rules.">
                            <field name="whatsapp_enable_bot"/>
                        </setting>
                    </block>

                    <block title="Data Retention &amp; Compliance" id="whatsapp_retention_setting">
                        <setting id="whatsapp_retention_setting" help="Days to keep chat history (0 to keep forever).">
                            <field name="whatsapp_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
