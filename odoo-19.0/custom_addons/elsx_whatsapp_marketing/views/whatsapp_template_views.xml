<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="name"/>
                <field name="account_id"/>
                <field name="category"/>
                <field name="language"/>
                <field name="status" decoration-success="status=='approved'"/>
                <field name="usage_count"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="template_id"/>
                        <field name="category"/>
                        <field name="language"/>
                    </group>
                    <group string="Header">
                        <field name="header_type"/>
                        <field name="header_text" invisible="header_type != 'text'"/>
                        <field name="header_media_url" invisible="header_type in ['none', 'text']"/>
                    </group>
                    <group string="Body">
                        <field name="body" widget="text"/>
                        <field name="footer"/>
                    </group>
                    <group string="Buttons" invisible="not has_buttons">
                        <field name="has_buttons"/>
                        <field name="button_type" invisible="not has_buttons"/>
                        <field name="button_text_1" invisible="not has_buttons"/>
                        <field name="button_text_2" invisible="not has_buttons"/>
                        <field name="button_text_3" invisible="not has_buttons"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
