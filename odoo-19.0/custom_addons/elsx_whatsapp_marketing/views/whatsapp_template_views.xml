<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="name"/>
                <field name="meta_template_name" optional="hide"/>
                <field name="account_id"/>
                <field name="category"/>
                <field name="language"/>
                <field name="language_code" optional="hide"/>
                <field name="status" decoration-success="status=='approved'"/>
                <field name="quality_score" optional="show"/>
                <field name="meta_state" optional="hide"/>
                <field name="usage_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template" class="o_whatsapp_template_form">
                <header>
                    <button name="action_submit_to_meta" string="Submit to Meta" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_open_meta_manager" string="Meta Manager" type="object" class="btn-secondary"/>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                    <button name="action_send_test" string="Send Test" type="object" class="btn-secondary" invisible="status != 'approved'"/>
                    <button name="action_generate_ai_draft" string="AI Draft Body" type="object" class="btn-secondary" invisible="status != 'draft'"/>
                    <button name="action_refresh_variables" string="Refresh Variables" type="object" class="btn-secondary" help="Manually refresh variable mappings from text"/>
                    <button name="action_duplicate" string="Duplicate" type="object" class="btn-secondary" invisible="not id"/>
                    <button name="action_archive_record" string="Archive" type="object" class="btn-secondary" invisible="not active"/>
                    <button name="action_unarchive_record" string="Unarchive" type="object" class="btn-primary" invisible="active"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,approved,paused,disabled,rejected"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="row">
                        <div class="col-md-7">
                            <group string="Configuration">
                                <field name="is_carousel"/>
                            </group>
                            <notebook invisible="is_carousel">
                                <page string="Standard Content" name="standard_content">
                                    <group>
                                        <field name="name"/>
                                        <field name="meta_template_name" readonly="status != 'draft'"/>
                                        <field name="account_id"/>
                                        <field name="template_id"/>
                                        <field name="category"/>
                                        <field name="language"/>
                                        <field name="language_code"/>
                                        <field name="quality_score" readonly="1"/>
                                        <field name="meta_state" readonly="1"/>
                                    </group>
                                    <group string="Header">
                                        <field name="header_type"/>
                                        <field name="header_text" invisible="header_type != 'text'"/>
                                        <field name="header_media_file" filename="header_media_filename" invisible="header_type not in ['image', 'video', 'document']"/>
                                        <field name="header_media_filename" invisible="1"/>
                                        <field name="header_media_url" invisible="header_type not in ['image', 'video', 'document']" readonly="1" force_save="1"/>
                                    </group>
                                    <group string="Body">
                                        <field name="body" widget="text"/>
                                        <field name="footer"/>
                                    </group>
                                    <group string="Buttons">
                                        <field name="has_buttons"/>
                                        <field name="button_type" invisible="not has_buttons"/>
                                        <field name="button_text_1" invisible="not has_buttons or button_type != 'quick_reply'"/>
                                        <field name="button_text_2" invisible="not has_buttons or button_type != 'quick_reply'"/>
                                        <field name="button_text_3" invisible="not has_buttons or button_type != 'quick_reply'"/>
                                        <div class="alert alert-info" role="alert" colspan="2" invisible="not has_buttons">
                                            Quick Reply buttons collect customer taps. Call to Action buttons open a URL or phone call. Copy Code is only for Authentication/OTP templates.
                                        </div>
                                    </group>
                                </page>
                            </notebook>
                            <notebook invisible="not is_carousel">
                                <page string="Carousel Cards" name="carousel_cards">
                                    <field name="card_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="header_type"/>
                                            <field name="header_media_file" filename="header_media_filename"/>
                                            <field name="header_media_filename" column_invisible="1"/>
                                            <field name="body"/>
                                            <field name="button_type_1"/>
                                            <field name="button_text_1"/>
                                            <field name="button_url_1" invisible="button_type_1 != 'url'"/>
                                            <field name="button_text_2"/>
                                        </list>
                                        <form string="Carousel Card">
                                            <group>
                                                <group string="Card Media">
                                                    <field name="sequence"/>
                                                    <field name="header_type"/>
                                                    <field name="header_media_file" filename="header_media_filename"/>
                                                    <field name="header_media_filename" invisible="1"/>
                                                    <field name="header_media_url" readonly="1" force_save="1"/>
                                                </group>
                                                <group string="Card Content">
                                                    <field name="body"/>
                                                    <field name="button_type_1"/>
                                                    <field name="button_text_1"/>
                                                    <field name="button_url_1" invisible="button_type_1 != 'url'"/>
                                                    <field name="button_text_2"/>
                                                </group>
                                            </group>
                                        </form>
                                    </field>
                                </page>
                            </notebook>
                            <group string="Buttons" invisible="is_carousel">
                                <field name="cta_url_text" invisible="not has_buttons or button_type != 'call_to_action'"/>
                                <field name="cta_url_link" invisible="not has_buttons or button_type != 'call_to_action'" placeholder="https://your-shop-or-catalogue-url"/>
                                <field name="cta_phone_text" invisible="not has_buttons or button_type != 'call_to_action'"/>
                                <field name="cta_phone_number" invisible="not has_buttons or button_type != 'call_to_action'"/>
                                <field name="copy_code_example" invisible="not has_buttons or button_type != 'copy_code'"/>
                                <field name="code_expiration_minutes" invisible="not has_buttons or button_type != 'copy_code'"/>
                                <div class="alert alert-info" role="alert" colspan="2" invisible="not has_buttons or button_type != 'call_to_action'">
                                    Use URL for catalogue/shop links and Phone for call sales. Template CTA buttons are the right option when the customer session is closed.
                                </div>
                            </group>
                            <group string="Meta Feedback" invisible="not rejection_reason">
                                <field name="rejection_reason" class="text-danger"/>
                            </group>
                            <group string="Meta Health">
                                <field name="meta_quality_rating" readonly="1"/>
                                <field name="meta_disabled_reason" readonly="1"/>
                                <field name="last_meta_event" readonly="1"/>
                                <field name="last_meta_event_date" readonly="1"/>
                            </group>
                        </div>
                        <div class="col-md-5">
                            <div class="card shadow-sm border-0 bg-light p-3 sticky-top" style="top: 20px;">
                                <h6 class="text-uppercase text-muted fw-bold mb-2">Customer Preview Checklist</h6>
                                <p class="text-muted small mb-2">Resolved text, media readiness, buttons, and Meta send warnings.</p>
                                <field name="preview_text" nolabel="1" readonly="1" class="wa-safe-preview-text"/>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Attributes &amp; Samples" name="attributes_samples">
                            <group>
                                <button name="action_refresh_variables" string="Refresh Variables" type="object" class="btn-secondary"/>
                            </group>
                            <field name="variable_ids" context="{'default_template_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" readonly="1"/>
                                    <field name="field_type" required="1"/>
                                    <field name="sample_value"/>
                                    <field name="odoo_field" placeholder="partner_id.name / name / amount_total"/>
                                    <field name="fallback_value"/>
                                </list>
                                <form string="Attribute Sample">
                                    <group>
                                        <group string="Variable">
                                            <field name="name" readonly="1"/>
                                            <field name="sequence"/>
                                            <field name="field_type" required="1"/>
                                        </group>
                                        <group string="Sample &amp; Mapping">
                                            <field name="sample_value"/>
                                            <field name="odoo_field" placeholder="partner_id.name / name / amount_total"/>
                                            <field name="fallback_value"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Meta Audit" name="meta_audit">
                            <field name="audit_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="create_date"/>
                                    <field name="event"/>
                                    <field name="status"/>
                                    <field name="reason"/>
                                </list>
                                <form string="Template Audit">
                                    <group>
                                        <field name="create_date" readonly="1"/>
                                        <field name="event" readonly="1"/>
                                        <field name="status" readonly="1"/>
                                        <field name="reason" readonly="1"/>
                                        <field name="raw_data" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_template_search" model="ir.ui.view">
        <field name="name">whatsapp.template.search</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Templates">
                <field name="name"/>
                <field name="meta_template_name"/>
                <field name="account_id"/>
                <field name="status"/>
                <filter name="active_records" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_records" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="approved_templates" string="Approved" domain="[('status', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_whatsapp_template_search"/>
        <field name="context">{'active_test': False, 'search_default_active_records': 1}</field>
    </record>

    <record id="action_whatsapp_template_archived" model="ir.actions.act_window">
        <field name="name">Archived Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_whatsapp_template_search"/>
        <field name="context">{'active_test': False, 'search_default_archived_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No archived templates</p>
            <p>Archived templates appear here so users can open them and click Unarchive.</p>
        </field>
    </record>
</odoo>
