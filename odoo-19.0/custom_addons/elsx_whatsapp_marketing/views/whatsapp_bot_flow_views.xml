<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bot Flow List View -->
    <record id="whatsapp_bot_flow_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.bot.flow.tree</field>
        <field name="model">whatsapp.bot.flow</field>
        <field name="arch" type="xml">
            <list string="Bot Flows" decoration-success="active" decoration-muted="not active">
                <field name="name"/>
                <field name="account_id"/>
                <field name="flow_type" widget="badge" decoration-info="flow_type == 'custom'" decoration-success="flow_type == 'greeting'" decoration-warning="flow_type == 'support'"/>
                <field name="trigger_type"/>
                <field name="trigger_count" string="Triggered"/>
                <field name="success_count" string="Success"/>
                <field name="failed_count" string="Failed"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Bot Flow Form with Visual Builder -->
    <record id="whatsapp_bot_flow_view_form" model="ir.ui.view">
        <field name="name">whatsapp.bot.flow.form</field>
        <field name="model">whatsapp.bot.flow</field>
        <field name="arch" type="xml">
            <form string="Bot Flow">
                <header>
                    <button name="action_open_visual_builder" type="object" string="Open Visual Builder" class="btn-primary" icon="fa-sitemap"/>
                    <button name="action_test_flow" type="object" string="Test Flow" class="btn-primary"/>
                    <button name="action_view_logs" type="object" string="View Logs" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-bolt" name="action_view_logs" type="object">
                            <field name="trigger_count" widget="statinfo" string="Triggered"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle" type="object" name="action_view_logs">
                            <field name="success_count" widget="statinfo" string="Success"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-times-circle" type="object" name="action_view_logs">
                            <field name="failed_count" widget="statinfo" string="Failed"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Flow Name"/></h1>
                    </div>

                    <group>
                        <group string="Configuration">
                            <field name="account_id" required="1"/>
                            <field name="flow_type"/>
                            <field name="trigger_type"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group string="Trigger Settings">
                            <field name="keywords" invisible="trigger_type != 'keyword'" placeholder="hello, hi, start"/>
                            <field name="schedule_pattern" invisible="trigger_type != 'schedule'" placeholder="0 9 * * *"/>
                            <field name="webhook_event" invisible="trigger_type != 'webhook'" placeholder="order.created"/>
                            <field name="retry_on_failure"/>
                            <field name="max_retries" invisible="not retry_on_failure"/>
                        </group>
                    </group>

                    <field name="description" placeholder="Describe this automation flow..."/>

                    <notebook>
                        <page string="Visual Flow Builder" name="visual_builder" icon="fa-sitemap">
                            <!-- New OWL 2.0 Visual Builder Widget -->
                            <field name="canvas_data" widget="wa_flow_builder" nolabel="1"/>
                        </page>

                        <page string="Steps (List)" name="steps_list" icon="fa-list">
                            <field name="step_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="step_number"/>
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="next_step_id"/>
                                </list>
                                <form string="Flow Step">
                                    <group>
                                        <group>
                                            <field name="step_number"/>
                                            <field name="name"/>
                                            <field name="action_type"/>
                                            <field name="next_step_id"/>
                                        </group>
                                        <group>
                                            <field name="message_text" invisible="action_type not in ['send_text', 'send_buttons', 'send_media', 'create_lead']"/>
                                            <field name="template_id" invisible="action_type != 'send_template'" domain="[('account_id', '=', parent.account_id), ('status', '=', 'approved')]"/>
                                            <field name="media_id" invisible="action_type != 'send_media'" domain="[('account_id', '=', parent.account_id)]"/>
                                            <field name="assign_user_id" invisible="action_type != 'transfer'"/>
                                            <field name="assign_tag_id" invisible="action_type != 'assign_tag'"/>
                                            <field name="delay_seconds" invisible="action_type != 'delay'"/>
                                        </group>
                                    </group>
                                    <group string="Condition" invisible="action_type != 'condition'">
                                        <field name="condition_type"/>
                                        <field name="condition_value"/>
                                        <field name="condition_true_step"/>
                                        <field name="condition_false_step"/>
                                    </group>
                                    <group string="HTTP Request" invisible="action_type != 'http_request'">
                                        <field name="http_method"/>
                                        <field name="http_url"/>
                                        <field name="http_payload"/>
                                    </group>
                                    <group string="Variables" invisible="action_type not in ['set_variable', 'wait_response']">
                                        <field name="save_response" invisible="action_type != 'wait_response'"/>
                                        <field name="response_variable" invisible="action_type != 'wait_response'"/>
                                        <field name="variable_name" invisible="action_type != 'set_variable'"/>
                                        <field name="variable_value" invisible="action_type != 'set_variable'"/>
                                    </group>
                                    <group string="Quick Reply Buttons" invisible="action_type != 'send_buttons'">
                                        <field name="button_ids" nolabel="1">
                                            <list editable="bottom">
                                                <field name="name"/>
                                                <field name="button_id"/>
                                                <field name="next_step_id"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Execution Logs" name="logs" icon="fa-history">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="phone_number"/>
                                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'running'"/>
                                    <field name="completed_steps"/>
                                    <field name="total_steps"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_bot_flow_action" model="ir.actions.act_window">
        <field name="name">Bot Flows</field>
        <field name="res_model">whatsapp.bot.flow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first chatbot automation flow
            </p>
            <p>Design visual chatbot flows with drag-and-drop nodes.</p>
        </field>
    </record>

    <record id="action_whatsapp_bot_flow_builder_client" model="ir.actions.client">
        <field name="name">Visual Flow Builder</field>
        <field name="tag">elsx_whatsapp_flow_builder</field>
    </record>
</odoo>
