<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Chat Kanban View (Inbox List) -->
    <record id="view_whatsapp_chat_kanban" model="ir.ui.view">
        <field name="name">whatsapp.chat.kanban</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" sample="1">
                <field name="display_name"/>
                <field name="last_message_date"/>
                <field name="last_message_body"/>
                <field name="unread_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </strong>
                            </div>
                            <span class="text-muted fs-6">
                                <field name="last_message_date" widget="remaining_days"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_body">
                            <p class="text-truncate mb-0" style="max-width: 250px;">
                                <t t-esc="record.last_message_body.value"/>
                            </p>
                        </div>
                        <div class="o_kanban_record_bottom mt-1">
                            <div class="oe_kanban_bottom_left">
                                <span t-if="record.unread_count.raw_value > 0" class="badge rounded-pill bg-danger">
                                    <t t-esc="record.unread_count.raw_value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WhatsApp Chat Form View (Conversation View) -->
    <record id="view_whatsapp_chat_form" model="ir.ui.view">
        <field name="name">whatsapp.chat.form</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <form string="Conversation" create="false">
                <header>
                    <button name="action_mark_as_read" string="Mark as Read" type="object" invisible="unread_count == 0"/>
                    <button name="action_open_send_wizard" string="Send Template" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="row">
                        <div class="col-8" style="border-right: 1px solid #dee2e6; height: 80vh; display: flex; flex-direction: column;">
                            <!-- Chat Header -->
                            <div class="d-flex align-items-center mb-3 p-2 bg-light rounded">
                                <div class="flex-shrink-0">
                                    <span class="fa fa-user-circle fa-3x text-muted"/>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h4 class="mb-0"><field name="display_name" readonly="1"/></h4>
                                    <small class="text-muted"><field name="phone_number" readonly="1"/></small>
                                </div>
                            </div>
                            
                            <!-- Message History (Bubble Style) -->
                            <div class="o_whatsapp_chat_history flex-grow-1 overflow-auto p-3 bg-white" style="background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png'); background-repeat: repeat;">
                                <field name="message_ids" mode="kanban" readonly="1">
                                    <kanban create="false" action="False">
                                        <field name="direction"/>
                                        <field name="body"/>
                                        <field name="status"/>
                                        <field name="create_date"/>
                                        <templates>
                                            <t t-name="card">
                                                <div t-attf-class="d-flex mb-2 #{record.direction.raw_value == 'outbound' ? 'justify-content-end' : 'justify-content-start'}">
                                                    <div t-attf-class="p-2 rounded shadow-sm #{record.direction.raw_value == 'outbound' ? 'bg-primary text-white' : 'bg-light text-dark'}" style="max-width: 75%;">
                                                        <p class="mb-1"><field name="body"/></p>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <small style="font-size: 0.7rem; opacity: 0.8;"><field name="create_date" widget="datetime"/></small>
                                                            <span t-if="record.direction.raw_value == 'outbound'" class="ms-2">
                                                                <i t-if="record.status.raw_value == 'sent'" class="fa fa-check"/>
                                                                <i t-if="record.status.raw_value == 'delivered'" class="fa fa-check text-white-50"/>
                                                                <i t-if="record.status.raw_value == 'read'" class="fa fa-check-circle text-info"/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </div>
                            
                            <!-- Quick Reply Footer -->
                            <div class="p-3 bg-light border-top">
                                <group col="2">
                                    <field name="quick_reply_text" nolabel="1" placeholder="Type a message..." style="width: 100%; border-radius: 20px; padding: 10px;"/>
                                    <button name="action_send_quick_reply" string="Send" type="object" class="btn-primary" icon="fa-paper-plane" invisible="not quick_reply_text"/>
                                </group>
                            </div>
                        </div>
                        <div class="col-4">
                            <group string="Customer Details">
                                <field name="partner_id"/>
                                <field name="account_id" readonly="1"/>
                                <field name="last_message_date" readonly="1"/>
                                <field name="unread_count" readonly="1"/>
                            </group>
                            <hr/>
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"/> This conversation is synced with your Meta WhatsApp Business API.
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Team Inbox Action -->
    <record id="action_whatsapp_team_inbox" model="ir.actions.act_window">
        <field name="name">Team Inbox</field>
        <field name="res_model">whatsapp.chat</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active conversations found.
            </p>
            <p>
                Incoming WhatsApp messages will appear here.
            </p>
        </field>
    </record>
</odoo>
