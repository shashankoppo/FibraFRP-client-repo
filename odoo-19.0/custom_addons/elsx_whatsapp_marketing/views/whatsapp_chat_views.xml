<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Chat Kanban View (Industrial Team Inbox) -->
    <record id="view_whatsapp_chat_kanban" model="ir.ui.view">
        <field name="name">whatsapp.chat.kanban</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_whatsapp_inbox_kanban" create="false" sample="1" default_order="last_message_date desc">
                <field name="display_name"/>
                <field name="display_name_initial"/>
                <field name="last_message_date"/>
                <field name="last_message_date_str"/>
                <field name="last_message_body"/>
                <field name="last_message_status"/>
                <field name="last_message_direction"/>
                <field name="unread_count"/>
                <field name="state"/>
                <field name="is_pinned"/>
                <field name="id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_whatsapp_kanban_card d-flex align-items-center p-3 border-bottom position-relative"
                             t-att-style="record.is_pinned.raw_value ? 'background: #f8fafc; border-left: 4px solid #00A884;' : 'border-left: 4px solid transparent;'">

                            <!-- Left: Avatar -->
                            <div class="o_whatsapp_avatar_container me-3 position-relative">
                                <div class="o_whatsapp_avatar d-flex align-items-center justify-content-center rounded-circle shadow-sm"
                                     style="width: 48px; height: 48px; background: linear-gradient(135deg, #00A884, #008F72); color: white; font-weight: bold; font-size: 1.2rem;">
                                    <field name="display_name_initial"/>
                                </div>
                                <div t-if="record.state.raw_value == 'open'" class="position-absolute bg-success rounded-circle border border-2 border-white"
                                     style="width: 12px; height: 12px; bottom: 0; right: 0;" title="Open Conversation"/>
                            </div>

                            <!-- Center: Info -->
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 fw-bold text-truncate" style="color: #111B21; font-size: 1rem;">
                                        <t t-out="record.display_name.value"/>
                                        <i t-if="record.is_pinned.raw_value" class="fa fa-thumb-tack ms-1 text-muted" title="Pinned" style="font-size: 0.7rem;"/>
                                    </h6>
                                    <span class="small text-muted" style="font-size: 0.75rem;">
                                        <t t-out="record.last_message_date_str ? record.last_message_date_str.value : ''"/>
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="small text-muted text-truncate d-flex align-items-center gap-1" style="font-size: 0.85rem;">
                                        <t t-if="record.last_message_direction.raw_value == 'outbound'">
                                            <t t-if="record.last_message_status.raw_value == 'read'">
                                                <i class="fa fa-check text-info" title="Read" style="font-size: 0.7rem; margin-right: 2px;"/><i class="fa fa-check text-info" title="Read" style="font-size: 0.7rem; margin-left: -6px;"/>
                                            </t>
                                            <t t-elif="record.last_message_status.raw_value == 'delivered'">
                                                <i class="fa fa-check text-muted" title="Delivered" style="font-size: 0.7rem; margin-right: 2px;"/><i class="fa fa-check text-muted" title="Delivered" style="font-size: 0.7rem; margin-left: -6px;"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-check text-muted" title="Sent" style="font-size: 0.7rem;"/>
                                            </t>
                                        </t>
                                        <t t-out="record.last_message_body.value or 'No messages yet'"/>
                                    </div>
                                    <div t-if="record.unread_count.raw_value > 0" class="badge rounded-pill bg-success shadow-sm ms-2" style="padding: 4px 8px; font-size: 0.7rem;">
                                        <t t-out="record.unread_count.value"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- WhatsApp Chat List View (Bulk Management) -->
    <record id="view_whatsapp_chat_list" model="ir.ui.view">
        <field name="name">whatsapp.chat.list</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'open'" decoration-muted="state == 'resolved'" decoration-warning="state == 'snoozed'" sample="1">
                <field name="is_pinned" widget="boolean_favorite" nolabel="1"/>
                <field name="display_name" string="Contact"/>
                <field name="phone_number"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="last_message_body" string="Last Message"/>
                <field name="last_message_date" widget="remaining_days"/>
                <field name="unread_count" widget="badge" decoration-danger="unread_count > 0" invisible="unread_count == 0"/>
                <field name="state" widget="badge" decoration-success="state == 'resolved'" decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <!-- WhatsApp Chat Form View (Conversation View) -->
    <record id="view_whatsapp_chat_form" model="ir.ui.view">
        <field name="name">whatsapp.chat.form</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <form string="Conversation" create="false" class="o_whatsapp_chat_form_view">

                <sheet>
                    <div class="o_whatsapp_chat_container d-flex position-relative">
                        <field name="unread_count" invisible="1"/>
                        <field name="account_id" invisible="1"/>
                        <field name="partner_id" invisible="1"/>
                        <!-- Hidden buttons for JS to trigger instant refresh/paging -->
                        <button name="action_reload_chat" type="object" string="Refresh" class="wa-hidden-reload-btn d-none" style="position: absolute; left: -9999px; visibility: hidden;"/>
                        <button name="action_load_more" type="object" string="Load More" class="wa-hidden-load-more-btn d-none" style="position: absolute; left: -9999px; visibility: hidden;"/>
                        <field name="is_pinned" invisible="1"/>
                        <field name="is_archived" invisible="1"/>
                        <field name="lead_id" invisible="1"/>
                        <field name="lead_state" invisible="1"/>
                        <field name="state" invisible="1"/>

                        <field name="partner_has_avatar" invisible="1"/>
                        <field name="session_open" invisible="1"/>

                        <!-- Sidebar: Real Chat List -->
                        <div class="o_whatsapp_chat_sidebar wa-left-sidebar d-none d-lg-flex flex-column border-end bg-white">
                                <div class="p-3 o_whatsapp_panel_header bg-white border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                         <div class="d-flex align-items-baseline gap-2">
                                             <h4 class="mb-0 fw-bold" style="color: #111B21;">Team Inbox</h4>
                                         </div>
                                         <div class="d-flex gap-3 text-muted align-items-center">
                                             <button type="action" name="%(elsx_whatsapp_marketing.whatsapp_bot_flow_action)d" class="btn btn-link p-0 text-muted" title="Automation Flows">
                                                 <i class="fa fa-code-fork" title="Flows"/>
                                             </button>
                                             <button name="action_open_meta_manager" type="object" class="btn btn-link p-0 text-success" title="Meta Template Manager">
                                                 <i class="fa fa-facebook-square cursor-pointer" title="Meta Template Manager"/>
                                             </button>
                                             <button name="%(action_whatsapp_new_chat_wizard)d" type="action" class="btn btn-link p-0 text-muted" title="New Chat">
                                                 <i class="fa fa-commenting-o cursor-pointer" title="New Chat"/>
                                             </button>
                                             <button name="%(action_whatsapp_account)d" type="action" class="btn btn-link p-0 text-muted" title="Accounts">
                                                 <i class="fa fa-ellipsis-v cursor-pointer" title="Accounts"/>
                                             </button>
                                         </div>
                                     </div>
                                     <div id="wa-account-selector-mount" class="mb-2"></div>
                                     <div class="position-relative mb-1">
                                         <input type="text" id="wa-sidebar-search-input" class="o_whatsapp_search_box w-100 ps-5" placeholder="Search or start new chat"/>
                                         <i class="fa fa-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted" title="Search" style="font-size: 0.9rem;"/>
                                     </div>
                                     <!-- Horizontal Filter Pills -->
                                     <div id="wa-sidebar-filters" class="d-flex gap-2 overflow-auto o_whatsapp_inbox_filters pb-0 pt-3" style="scrollbar-width: none;">
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold" style="font-size: 0.8rem; background: #e7f7f3; color: #00A884;" data-filter="all">All</button>
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold text-muted bg-light" style="font-size: 0.8rem;" data-filter="open">Open</button>
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold text-muted bg-light" style="font-size: 0.8rem;" data-filter="unread">Unread</button>
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold text-muted bg-light" style="font-size: 0.8rem;" data-filter="mine">Mine</button>
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold text-muted bg-light" style="font-size: 0.8rem;" data-filter="snoozed">Snoozed</button>
                                         <button type="button" class="wa-filter-btn px-3 py-1 rounded-pill border-0 fw-semibold text-muted bg-light" style="font-size: 0.8rem;" data-filter="resolved">Resolved</button>
                                     </div>
                                </div>
                                 <!-- Three-Pane Tabs (AiSensy/WATI style) -->
                                 <div class="d-flex border-bottom bg-white" style="z-index: 10;">
                                     <button type="button" class="btn btn-link flex-grow-1 text-decoration-none text-dark fw-bold border-bottom border-3 border-success rounded-0 wa-pane-tab px-1 py-2" data-pane="active" style="font-size: 0.85rem;">
                                         Mine <span class="badge bg-success rounded-pill ms-1 wa-pane-count-active">0</span>
                                     </button>
                                     <button type="button" class="btn btn-link flex-grow-1 text-decoration-none text-muted fw-bold border-bottom border-3 border-transparent rounded-0 wa-pane-tab px-1 py-2" data-pane="request" style="font-size: 0.85rem; border-color: transparent;">
                                         Unassigned <span class="badge bg-secondary rounded-pill ms-1 wa-pane-count-request">0</span>
                                     </button>
                                     <button type="button" class="btn btn-link flex-grow-1 text-decoration-none text-muted fw-bold border-bottom border-3 border-transparent rounded-0 wa-pane-tab px-1 py-2" data-pane="intervened" style="font-size: 0.85rem; border-color: transparent;">
                                         All <span class="badge bg-secondary rounded-pill ms-1 wa-pane-count-intervened">0</span>
                                     </button>
                                 </div>

                                 <!-- Custom JS Mount Points for Three-Pane Sidebar -->
                                 <div id="wa-active-sidebar-mount" class="flex-grow-1 overflow-auto position-relative wa-pane-mount">
                                     <!-- JS will inject active chat cards here -->
                                 </div>
                                 <div id="wa-request-sidebar-mount" class="flex-grow-1 overflow-auto position-relative wa-pane-mount d-none">
                                     <!-- JS will inject request chat cards here -->
                                 </div>
                                 <div id="wa-intervened-sidebar-mount" class="flex-grow-1 overflow-auto position-relative wa-pane-mount d-none">
                                     <!-- JS will inject intervened chat cards here -->
                                 </div>
                        </div>

                        <!-- Main Chat Area -->
                        <div class="o_whatsapp_chat_main d-flex flex-column flex-grow-1">
                            <!-- Header - Flat Professional Design -->
                            <div class="p-2 px-3 border-bottom d-flex align-items-center justify-content-between bg-white" style="z-index: 10;">
                                <div class="d-flex align-items-center">
                                    <button type="button" class="btn btn-link p-0 me-3 d-lg-none wa-mobile-back-btn text-dark" title="Back to Chats">
                                        <i class="fa fa-arrow-left fa-lg" title="Back"></i>
                                    </button>
                                    <div class="o_whatsapp_avatar o_whatsapp_avatar_header position-relative me-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #e7f7f3; color: #00A884;">
                                        <span class="o_whatsapp_avatar_initial fw-bold" style="font-size:1.1rem;"><field name="display_name_initial"/></span>
                                        <!-- Real-time Status Indicator Hook -->
                                        <div id="whatsapp_socket_status" class="position-absolute bottom-0 end-0 bg-secondary border border-2 border-white rounded-circle" style="width: 14px; height: 14px;" title="Sidecar Status"/>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h5 class="mb-0 fw-bold o_whatsapp_header_name" style="font-size: 1.1rem; color: #111B21;">
                                                <span class="o_whatsapp_contact_name"><field name="display_name" readonly="1"/></span>
                                            </h5>
                                            <span class="o_whatsapp_session_badge"><field name="state" widget="badge" decoration-success="state == 'resolved'" decoration-info="state == 'open'" decoration-warning="state == 'snoozed'"/></span>

                                            <!-- SLA Status Badges for Form View -->
                                            <div invisible="sla_status != 'breached'" class="badge bg-danger shadow-sm ms-2" style="font-size: 0.75rem; animation: pulse 2s infinite;">
                                                <i class="fa fa-warning me-1" title="SLA Breach Icon"/>SLA Breach
                                            </div>
                                            <div invisible="sla_status != 'active'" class="badge bg-warning text-dark shadow-sm ms-2 wa-sla-timer" style="font-size: 0.75rem;">
                                                <i class="fa fa-clock-o me-1" title="SLA Timer Icon"/> <span class="wa-sla-value"><field name="sla_timer_minutes" nolabel="1" class="d-inline"/></span>m wait
                                            </div>
                                            <field name="sla_status" invisible="1"/>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="small text-muted" style="font-size: 0.75rem;">
                                                <i class="fa fa-phone me-1" title="Phone"/> <span class="o_whatsapp_contact_phone">Contact Phone</span>
                                            </span>
                                            <span invisible="not assigned_user_id" class="small text-primary d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; background: #E3F2FD; padding: 2px 8px; border-radius: 4px;">
                                                <i class="fa fa-user" title="Assigned Agent"/> <field name="assigned_user_id" readonly="1" options="{'no_open': True}"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <!-- Flat Action Buttons -->
                                    <div class="d-flex bg-light rounded-pill p-1 border">
                                        <button name="action_snooze" type="object" class="btn btn-sm text-muted rounded-circle border-0 d-flex align-items-center justify-content-center hover-bg-white" style="width:32px;height:32px;" title="Snooze" invisible="state == 'snoozed'">
                                            <i class="fa fa-clock-o" title="Snooze"/>
                                        </button>
                                        <button name="action_resolve" type="object" class="btn btn-sm text-muted rounded-circle border-0 d-flex align-items-center justify-content-center hover-bg-white" style="width:32px;height:32px;" title="Resolve" invisible="state == 'resolved'">
                                            <i class="fa fa-check" title="Resolve"/>
                                        </button>
                                        <button name="action_reopen" type="object" class="btn btn-sm text-primary rounded-circle border-0 d-flex align-items-center justify-content-center hover-bg-white" style="width:32px;height:32px;" title="Re-open" invisible="state == 'open'">
                                            <i class="fa fa-undo" title="Re-open"/>
                                        </button>
                                    </div>
                                    <div class="ms-2 d-flex gap-2 align-items-center">
                                         <button name="action_open_send_wizard" type="object" class="btn btn-success btn-sm px-3 fw-semibold rounded" style="background: #00A884; border: none;" title="Send Template">
                                             <i class="fa fa-magic me-1" title="Template"/> Template
                                         </button>
                                         <button type="button" class="btn btn-light btn-sm rounded border d-flex align-items-center justify-content-center wa-toggle-right-pane-btn d-none d-lg-flex text-muted" style="width:34px;height:34px;" title="Toggle Contact Info">
                                             <i class="fa fa-info-circle fa-lg" title="Toggle Info"/>
                                         </button>
                                     </div>
                                </div>
                            </div>

                            <!-- Messages Area - Surgical Zero-Flicker View -->
                            <div class="o_whatsapp_chat_history flex-grow-1 overflow-auto d-flex flex-column" id="wa_chat_history">
                                <div class="wa-chat-history-content-container p-3 d-flex flex-column gap-2 flex-grow-1">
                                    <field name="history_html" invisible="1" class="wa-hidden-history-field"/>
                                    <div id="wa-custom-history-mount" class="flex-grow-1 d-flex flex-column gap-2"></div>
                                </div>
                                <field name="message_ids" invisible="1"/>
                            </div>


                            <!-- Smart Chat Footer -->
                            <div class="o_whatsapp_chat_footer">
                                <field name="quick_media_filename" invisible="1"/>

                                <!-- SESSION CLOSED: Show Template Picker (primary action) -->
                                <div invisible="session_open" class="o_whatsapp_template_row wa-composer-shell wa-composer-closed">
                                    <i class="fa fa-lock text-warning me-1" title="Session Closed"/>
                                    <span class="small fw-semibold text-muted me-2" style="white-space:nowrap;">Session closed - send a template:</span>
                                    <div class="flex-grow-1">
                                        <field name="quick_template_id" nolabel="1" placeholder="Select approved template..." domain="[('status', '=', 'approved'), '|', ('account_id', '=', False), ('account_id', '=', account_id)]" options="{'no_create': True}" class="w-100"/>
                                    </div>
                                    <button name="action_send_quick_template" type="object" class="o_whatsapp_template_send_btn btn ms-2">
                                        <i class="fa fa-paper-plane me-1" title="Send Template"/> Send Template
                                    </button>
                                    <button name="action_open_send_wizard" type="object" class="btn btn-outline-secondary btn-sm ms-1" title="Advanced options">
                                        <i class="fa fa-cog" title="Advanced Options"/>
                                    </button>
                                </div>
                                <div invisible="session_open or not quick_template_id" class="wa-closed-template-preview px-3 pb-2">
                                    <div class="wa-template-preview-safe">
                                        <div class="wa-template-preview-safe-title">
                                            <i class="fa fa-eye me-1" title="Preview"/> Customer preview checklist
                                        </div>
                                        <field name="quick_template_preview_html" nolabel="1" readonly="1" widget="html" class="wa-preview-html-field"/>
                                    </div>
                                </div>

                                <!-- SESSION OPEN: Normal text + media input -->
                                 <div invisible="not session_open" class="wa-premium-footer-bar wa-composer-shell bg-white border-top p-2" style="z-index: 10;">
                                    <div class="wa-composer-surface">
                                        <!-- Left Side Icons -->
                                        <div class="wa-composer-tools">
                                            <!-- Emoji Picker -->
                                            <button id="wa_emoji_trigger" type="button" class="wa-footer-icon-btn" title="Emojis" data-wa-label="Emoji" aria-label="Emoji picker">
                                                <i class="fa fa-smile-o" title="Emojis"/>
                                            </button>
                                            <button id="wa_quick_reply_trigger" type="button" class="wa-footer-icon-btn wa-quick-reply-trigger-btn" title="Quick Replies" data-wa-label="Replies" aria-label="Quick replies">
                                                <i class="fa fa-bolt" title="Quick Replies"/>
                                            </button>

                                            <!-- Attachment Button -->
                                            <div class="wa-attachment-wrapper wa-footer-icon-btn position-relative" title="Attach file or media" data-wa-label="Attach" aria-label="Attach file or media">
                                                <i class="fa fa-paperclip wa-attachment-trigger-icon" title="Attach Media"/>
                                                <field name="quick_media_file" filename="quick_media_filename" widget="binary" nolabel="1" options="{'accepted_file_extensions': 'image/*, video/*, audio/*, application/pdf, application/msword, application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/vnd.ms-excel, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, text/plain'}" class="wa-hidden-binary"/>
                                            </div>

                                            <!-- Template Quick Access -->
                                            <button name="action_open_send_wizard" type="object" class="wa-footer-icon-btn wa-template-trigger-btn d-none d-md-flex" title="Open Templates" data-wa-label="Templates" aria-label="Open template sender">
                                                <i class="fa fa-list-alt" title="Open Templates"/>
                                            </button>
                                            <button name="action_generate_ai_reply" type="object" class="wa-footer-icon-btn wa-ai-trigger-btn d-none d-md-flex" title="Draft AI Reply" data-wa-label="AI draft" aria-label="Generate AI draft reply">
                                                <i class="fa fa-lightbulb-o" title="Draft AI Reply"/>
                                            </button>
                                        </div>

                                        <!-- Text Input Area -->
                                        <div class="wa-composer-input-wrap">
                                            <!-- Floating media preview if file selected -->
                                            <div invisible="not quick_media_file" class="wa-floating-attachment-preview mb-1 p-2 bg-light rounded border d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fa fa-file-image-o text-success" title="Selected Media"/>
                                                    <span class="text-truncate small fw-bold" style="max-width: 150px;"><field name="quick_media_filename"/></span>
                                                </div>
                                                <button name="action_clear_media" type="object" class="btn btn-sm btn-link p-0 text-danger" style="font-size: 0.9rem;">
                                                    <i class="fa fa-times-circle" title="Remove Media"/>
                                                </button>
                                            </div>
                                            <div id="wa_quick_reply_popover" class="wa-quick-reply-popover d-none"></div>
                                            <div class="wa-message-input-frame">
                                                <field name="quick_reply_text" widget="text" class="wa-premium-input" placeholder="Type a message..." nolabel="1"/>
                                                <div class="wa-composer-meta">
                                                    <span id="wa_composer_counter">0/4096</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right Side Actions -->
                                        <div class="wa-composer-actions">
                                            <!-- Internal Note -->
                                            <button name="action_send_internal_note" type="object" class="wa-footer-icon-btn wa-note-btn" title="Internal Note" data-wa-label="Note" aria-label="Internal note">
                                                <i class="fa fa-sticky-note-o" title="Internal Note"/>
                                            </button>

                                            <!-- Send Button -->
                                            <button name="action_send_quick_reply" type="object" class="wa-main-send-btn shadow-sm">
                                                <i class="fa fa-send" title="Send"/>
                                            </button>
                                        </div>
                                        <field name="ai_suggested_reply" invisible="1"/>
                                        <field name="ai_intent" invisible="1"/>
                                        <field name="ai_sentiment" invisible="1"/>
                                        <field name="ai_urgency" invisible="1"/>
                                        <field name="ai_next_action" invisible="1"/>
                                        <field name="ai_suggested_tags" invisible="1"/>
                                        <field name="ai_suggested_flow_id" invisible="1"/>
                                        <div class="wa-ai-guidance d-none" role="status">
                                            <div class="wa-ai-guidance-runtime"/>
                                            <div class="wa-ai-actions">
                                                <button name="action_use_ai_suggested_reply" type="object" class="btn btn-sm btn-success" invisible="not ai_suggested_reply">
                                                    <i class="fa fa-check me-1" title="Use Draft"/> Use Draft
                                                </button>
                                                <button name="action_generate_ai_reply" type="object" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fa fa-refresh me-1" title="Regenerate"/> Regenerate
                                                </button>
                                                <button name="action_start_ai_suggested_flow" type="object" class="btn btn-sm btn-outline-primary" invisible="not ai_suggested_flow_id">
                                                    <i class="fa fa-code-fork me-1" title="Start Suggested Flow"/> Start Flow
                                                </button>
                                                <button name="action_open_ai_flow_manager" type="object" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-sitemap me-1" title="Manage Flows"/> Manage Flows
                                                </button>
                                                <button name="action_clear_ai_guidance" type="object" class="btn btn-sm btn-link text-muted">
                                                    Clear
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Sidebar: Contact Info & Profile -->
                        <div class="o_whatsapp_chat_sidebar wa-right-sidebar flex-shrink-0 border-start overflow-auto p-0 d-none bg-white" style="width: 340px;">
                            <div class="text-center p-4 border-bottom bg-light">
                                <field name="partner_avatar_128" widget="image" class="rounded-circle shadow-sm mx-auto mb-3 d-block" options="{'size': [80, 80]}" invisible="not partner_has_avatar"/>
                                <div invisible="partner_has_avatar" class="o_whatsapp_profile_pic_large mx-auto mb-3 d-flex align-items-center justify-content-center bg-white text-primary fw-bold rounded-circle shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                                    <field name="display_name_initial"/>
                                </div>
                                <h4 class="mb-1 fw-bold"><field name="display_name"/></h4>
                                <div class="text-muted small mb-2"><i class="fa fa-phone me-1" title="Phone"/> <field name="phone_number"/></div>
                                <div invisible="not whatsapp_profile_about" class="badge p-2 w-100 text-wrap fw-normal o_whatsapp_profile_about" style="font-size: 0.85rem;">
                                    <i class="fa fa-quote-left me-1 opacity-50" title="About"/> <field name="whatsapp_profile_about"/>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">WhatsApp Profile</h6>
                                <div class="bg-light p-3 rounded-3 border">
                                    <div class="mb-2">
                                        <span class="o_form_label text-muted small d-block">Public Name</span>
                                        <span class="fw-bold"><field name="whatsapp_profile_name" placeholder="Unknown"/></span>
                                    </div>
                                     <div class="mb-2">
                                         <span class="o_form_label text-muted small d-block">Assigned Agent</span>
                                         <field name="assigned_user_id" widget="many2one_avatar_user" placeholder="Select Agent..."/>
                                     </div>
                                     <div>
                                        <span class="o_form_label text-muted small d-block">Business Status</span>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Verified API Account</span>
                                    </div>
                                </div>
                            </div>

                            <div class="p-3">
                                <!-- CRM & Contact Context Cards -->
                                <div class="mb-4">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="fa fa-id-card text-muted" title="CRM Context"/>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Lead / Opportunity</h6>
                                    </div>
                                    <div class="p-3 rounded border bg-white mb-2 shadow-sm wa-lead-card" invisible="not lead_id">
                                        <div class="fw-bold text-dark" style="font-size: 0.9rem;"><field name="lead_id"/></div>
                                        <div class="badge bg-light text-dark border mt-2"><field name="lead_state"/></div>
                                    </div>
                                    <div class="wa-empty-lead-card mb-2" invisible="lead_id">
                                        <i class="fa fa-info-circle me-1" title="No Lead"/>
                                        No linked opportunity yet.
                                    </div>
                                    <div class="d-flex justify-content-between text-center mt-3 mb-2 px-1">
                                        <div class="p-2 bg-light rounded flex-fill me-1 border shadow-sm">
                                            <div class="fw-bold text-primary wa-crm-orders-count" style="font-size: 1.1rem;"><field name="sale_order_count"/></div>
                                            <div class="text-muted" style="font-size: 0.7rem;">Orders</div>
                                        </div>
                                        <div class="p-2 bg-light rounded flex-fill ms-1 border shadow-sm">
                                            <div class="fw-bold text-success wa-crm-invoices-count" style="font-size: 1.1rem;"><field name="invoice_count"/></div>
                                            <div class="text-muted" style="font-size: 0.7rem;">Invoices</div>
                                        </div>
                                    </div>
                                    <button name="action_view_partner" type="object" class="btn btn-sm btn-outline-primary w-100 mt-2 wa-view-partner-btn">
                                        <i class="fa fa-external-link me-1" title="View Partner"/> View Partner
                                    </button>
                                    <div class="d-flex gap-2 mt-2">
                                        <button name="action_create_opportunity" type="object" class="btn btn-sm btn-outline-success flex-fill fw-semibold">
                                            <i class="fa fa-plus me-1" title="Opportunity"/> Opportunity
                                        </button>
                                        <button name="action_create_quote" type="object" class="btn btn-sm btn-outline-info flex-fill fw-semibold">
                                            <i class="fa fa-file-text-o me-1" title="Create Quote"/> New Quote
                                        </button>
                                    </div>
                                    <div class="small text-muted mt-2">
                                        Create the CRM record first. Use the payment shortcut after a quotation or invoice exists.
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="fa fa-bolt text-muted" title="Action Shortcuts"/>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Action Shortcuts</h6>
                                    </div>
                                    <div class="p-3 rounded border bg-white shadow-sm wa-action-shortcuts-card">
                                        <div class="small text-muted mb-2">
                                            Guided shortcuts for forms and payment links. The checklist below shows what will happen before you send.
                                        </div>
                                        <div class="wa-shortcut-guide mb-2">
                                            <field name="quick_action_help_text" readonly="1" nolabel="1" class="wa-shortcut-guide-text"/>
                                        </div>
                                        <field name="quick_form_id" placeholder="Select form or use account default"/>
                                        <field name="quick_invoice_id" placeholder="Optional unpaid invoice for payment link"/>
                                        <field name="quick_sale_order_id" placeholder="Optional quotation/order if no invoice is selected"/>
                                        <div class="d-grid gap-2 mt-2">
                                            <button name="action_send_form_link" type="object" class="btn btn-sm btn-outline-primary fw-semibold">
                                                <i class="fa fa-wpforms me-1" title="Send Form"/> Send Form Link
                                            </button>
                                            <button name="action_send_payment_link" type="object" class="btn btn-sm btn-outline-success fw-semibold">
                                                <i class="fa fa-credit-card me-1" title="Send Payment Link"/> Send Payment Link
                                            </button>
                                        </div>
                                        <div class="d-flex gap-2 mt-2">
                                            <button type="object" name="action_open_forms" class="btn btn-sm btn-light border flex-fill">
                                                <i class="fa fa-list-alt me-1" title="Forms"/> Forms
                                            </button>
                                            <button type="object" name="action_open_commerce_setup" class="btn btn-sm btn-light border flex-fill">
                                                <i class="fa fa-shopping-bag me-1" title="Commerce Setup"/> Shop Setup
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4" invisible="not source_campaign_id and not source_keyword">
                                    <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 1px;">Source Tracking</h6>
                                    <div class="p-3 bg-light rounded border shadow-sm">
                                        <div class="small text-muted">Campaign</div>
                                        <div class="fw-semibold text-truncate"><field name="source_campaign_id"/></div>
                                        <div class="small text-muted mt-2">Entry Keyword</div>
                                        <div class="fw-semibold text-truncate"><field name="source_keyword"/></div>
                                        <div class="small text-muted mt-2">Medium</div>
                                        <div class="fw-semibold text-truncate"><field name="source_medium"/></div>
                                        <field name="source_first_message_id" invisible="1"/>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <i class="fa fa-user-circle text-muted" title="Contact Details"/>
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Contact Details</h6>
                                    </div>
                                    <div class="d-flex flex-column gap-3 p-3 bg-light rounded border shadow-sm">
                                        <div class="d-flex align-items-start gap-3">
                                            <i class="fa fa-envelope text-muted mt-1" title="Email"/>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="text-muted small">Email</div>
                                                <div class="text-truncate fw-semibold" style="font-size: 0.85rem;"><field name="partner_id_email"/></div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-start gap-3">
                                            <i class="fa fa-briefcase text-muted mt-1" title="Job Title"/>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="text-muted small">Job Title</div>
                                                <div class="text-truncate fw-semibold" style="font-size: 0.85rem;"><field name="partner_job_title"/></div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-start gap-3">
                                            <i class="fa fa-globe text-muted mt-1" title="Website"/>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="text-muted small">Website</div>
                                                <div class="text-primary text-truncate fw-semibold" style="font-size: 0.85rem;"><field name="partner_website"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ADVANCED BUSINESS FEATURES (LABELS, NOTES, STATS) -->
                                <div class="mb-4">
                                    <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">WhatsApp Labels</h6>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="Add labels..." class="w-100"/>
                                </div>

                                <!-- This block is redundant with Orders/Invoices above, removing to save space -->

                                <div class="mb-4">
                                    <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Internal Notes</h6>
                                    <field name="note_ids" nolabel="1">
                                        <list editable="bottom" create="1" delete="1">
                                            <field name="create_date" string="Time" readonly="1" widget="datetime" options="{'format': 'MMM d, HH:mm'}"/>
                                            <field name="assigned_user_id" string="Agent" readonly="1" widget="many2one_avatar_user"/>
                                            <field name="body" string="Note"/>
                                        </list>
                                    </field>
                                </div>

                                <button name="action_open_contact" type="object" class="btn btn-light border w-100 py-2 mt-2 fw-semibold text-dark">
                                    <i class="fa fa-external-link me-2" title="Open Contact"/> View Contact
                                </button>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Team Inbox Action -->
    <record id="action_whatsapp_team_inbox" model="ir.actions.act_window">
        <field name="name">Team Inbox</field>
        <field name="res_model">whatsapp.chat</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Industrial Team Inbox is ready!
            </p>
            <p>Manage your enterprise conversations with real-time zero-latency synchronization.</p>
        </field>
    </record>

    <!-- Server Action to open the most recent chat directly in the Console (Form view) -->
    <record id="action_whatsapp_console_direct" model="ir.actions.server">
        <field name="name">WhatsApp Console</field>
        <field name="model_id" ref="model_whatsapp_chat"/>
        <field name="state">code</field>
        <field name="code">
last_chat = env['whatsapp.chat'].search([('state', '=', 'open')], limit=1, order='last_message_date desc nulls last, id desc')
if not last_chat:
    last_chat = env['whatsapp.chat'].search([], limit=1, order='last_message_date desc nulls last, id desc')

if last_chat:
    action = last_chat.action_open_chat()
else:
    action = env.ref('elsx_whatsapp_marketing.action_whatsapp_team_inbox').read()[0]

action['target'] = 'current'
action['context'] = {'active_test': False}
action.pop('flags', None)
action['view_mode'] = 'form,kanban'
if not action.get('views'):
    action['views'] = [(False, 'form'), (False, 'kanban')]
action = action
        </field>
    </record>
</odoo>
