<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_whatsapp_link" model="ir.ui.view">
        <field name="name">crm.lead.form.whatsapp.link</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_open_whatsapp_link" string="WhatsApp Link" type="object" class="btn-secondary" icon="fa-whatsapp" invisible="not partner_id and not phone"/>
            </xpath>
        </field>
    </record>
</odoo>
