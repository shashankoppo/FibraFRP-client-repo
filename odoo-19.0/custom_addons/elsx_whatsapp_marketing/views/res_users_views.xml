<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_whatsapp_ui_version" model="ir.ui.view">
        <field name="name">res.users.form.whatsapp.ui.version</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="whatsapp_workspace_role"/>
                <field name="whatsapp_ui_version_override"/>
            </xpath>
        </field>
    </record>
</odoo>
