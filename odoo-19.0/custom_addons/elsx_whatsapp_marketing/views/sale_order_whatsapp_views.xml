<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_whatsapp_link" model="ir.ui.view">
        <field name="name">sale.order.form.whatsapp.link</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_open_whatsapp_link" string="WhatsApp Link" type="object" class="btn-secondary" icon="fa-whatsapp" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
