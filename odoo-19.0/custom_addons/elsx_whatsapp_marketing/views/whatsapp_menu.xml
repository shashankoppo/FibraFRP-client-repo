<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main WhatsApp Menu -->
    <menuitem id="menu_whatsapp_root"
              name="WhatsApp Marketing"
              sequence="50"
              web_icon="elsx_whatsapp_marketing,static/description/icon.png"/>

    <!-- Dashboard -->
    <menuitem id="menu_whatsapp_dashboard"
              name="Dashboard"
              parent="menu_whatsapp_root"
              sequence="1"/>

    <!-- Shared Inbox Conversations Action -->
    <record id="action_whatsapp_conversations" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_partner': 1, 'search_default_group_date': 1}</field>
    </record>

    <!-- Shared Inbox Conversations (Team Inbox) -->
    <menuitem id="menu_whatsapp_conversations"
              name="Team Inbox"
              parent="menu_whatsapp_root"
              sequence="5"
              action="action_whatsapp_team_inbox"/>

    <!-- Messages -->
    <menuitem id="menu_whatsapp_messages"
              name="Messages"
              parent="menu_whatsapp_root"
              sequence="10"
              action="action_whatsapp_message"/>

    <!-- Campaigns -->
    <menuitem id="menu_whatsapp_campaigns"
              name="Campaigns"
              parent="menu_whatsapp_root"
              sequence="20"
              action="action_whatsapp_campaign"/>

    <!-- Templates -->
    <menuitem id="menu_whatsapp_templates"
              name="Templates"
              parent="menu_whatsapp_root"
              sequence="30"
              action="action_whatsapp_template"/>

    <!-- Contacts -->
    <menuitem id="menu_whatsapp_contacts"
              name="Contacts"
              parent="menu_whatsapp_root"
              sequence="40"
              action="action_whatsapp_contact"/>

    <!-- Configuration -->
    <menuitem id="menu_whatsapp_config"
              name="Configuration"
              parent="menu_whatsapp_root"
              sequence="100"/>

    <menuitem id="menu_whatsapp_accounts"
              name="WhatsApp Accounts"
              parent="menu_whatsapp_config"
              sequence="10"
              action="action_whatsapp_account"/>
</odoo>
