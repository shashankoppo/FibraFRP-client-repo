<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Message Tree View -->
    <record id="view_whatsapp_message_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.tree</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Messages" decoration-info="direction=='inbound'" decoration-muted="status=='failed'">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="direction"/>
                <field name="message_type"/>
                <field name="interactive_type" optional="hide"/>
                <field name="body"/>
                <field name="preview_text" optional="hide"/>
                <field name="button_text" optional="hide"/>
                <field name="list_item_title" optional="hide"/>
                <field name="media_filename" optional="hide"/>
                <field name="status" decoration-success="status in ['delivered', 'read']" decoration-danger="status=='failed'"/>
                <field name="campaign_id"/>
            </list>
        </field>
    </record>

    <!-- WhatsApp Message Form View -->
    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <header>
                    <button name="action_send" string="Send" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_retry" string="Retry" type="object" class="btn-warning" invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                            <field name="direction"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                        </group>
                        <group>
                            <field name="message_type"/>
                            <field name="template_id" invisible="message_type != 'template'"/>
                            <field name="template_name" invisible="message_type != 'template'"/>
                            <field name="template_language" invisible="message_type != 'template'"/>
                            <field name="campaign_id"/>
                            <field name="is_automated"/>
                            <field name="trigger_event" invisible="not is_automated"/>
                        </group>
                    </group>
                    <group>
                        <field name="body" widget="text"/>
                        <field name="media_url" invisible="message_type == 'text'"/>
                        <field name="media_filename" invisible="message_type == 'text'"/>
                        <field name="media_mime_type" invisible="message_type == 'text'"/>
                        <field name="caption" invisible="message_type == 'text'"/>
                    </group>
                    <group string="Customer Preview">
                        <field name="preview_html" nolabel="1" readonly="1" widget="html" class="wa-preview-html-field"/>
                    </group>
                    <group string="Interactive / Commerce" invisible="message_type != 'interactive'">
                        <field name="interactive_type"/>
                        <field name="button_text"/>
                        <field name="button_payload"/>
                        <field name="list_item_title"/>
                        <field name="list_item_id"/>
                        <field name="button_url"/>
                        <field name="catalog_id"/>
                        <field name="product_retailer_id"/>
                    </group>
                    <group string="Status Information">
                        <group>
                            <field name="sent_date"/>
                            <field name="delivered_date"/>
                            <field name="read_date"/>
                        </group>
                        <group>
                            <field name="message_id"/>
                            <field name="error_message" invisible="status != 'failed'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Message Action -->
    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- WhatsApp Message Search View -->
    <record id="view_whatsapp_message_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search string="Search WhatsApp Messages">
                <field name="phone_number"/>
                <field name="partner_id"/>
                <field name="body"/>
                <filter name="inbound" string="Inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('direction', '=', 'outbound')]"/>
                <filter name="campaign_messages" string="Campaign Messages" domain="[('campaign_id', '!=', False)]"/>
                <filter name="campaign_replies" string="Campaign Replies" domain="[('campaign_id', '!=', False), ('direction', '=', 'inbound')]"/>
                <filter name="interactive" string="Interactive" domain="[('message_type', '=', 'interactive')]"/>
                <filter name="media_messages" string="Media" domain="[('message_type', 'in', ['image', 'video', 'document', 'audio'])]"/>
                <filter name="sent" string="Sent" domain="[('status', 'in', ['sent', 'delivered', 'read'])]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
