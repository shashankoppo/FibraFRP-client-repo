<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_send_wizard" model="ir.ui.view">
        <field name="name">whatsapp.send.wizard.form</field>
        <field name="model">whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <div class="row p-3">
                    <!-- Left Column: Form Fields -->
                    <div class="col-lg-7 border-end pe-4">
                        <div class="text-muted small mb-3 text-uppercase fw-bold" style="letter-spacing: 1px;">Message Configuration</div>
                        <group>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="phone_number" placeholder="e.g. 917247558873 (with country code, no +)"/>
                            <field name="partner_ids" widget="many2many_tags" invisible="phone_number != False"/>
                            <field name="template_requires_header_media" invisible="1"/>
                            <div invisible="not template_requires_header_media" class="alert alert-warning py-2 mb-2" role="alert">
                                This template uses a media header. Upload a file here if the template does not already have a default header file or Meta media URL.
                            </div>
                            <field name="media_file" filename="media_filename" invisible="template_id != False and not template_requires_header_media"/>
                            <field name="media_filename" invisible="1"/>
                            <field name="message_body" widget="text" placeholder="Type message or optional media/voice caption..." invisible="template_id != False"/>
                        </group>
                    </div>
                    
                    <!-- Right Column: safe customer preview -->
                    <div class="col-lg-5 ps-4">
                        <div class="text-muted small mb-3 text-uppercase fw-bold" style="letter-spacing: 1px;">Customer Preview</div>
                        
                        <div invisible="template_id != False" class="d-flex flex-column align-items-center justify-content-center h-100 text-center" style="background: #F8F9FA; border-radius: 12px; border: 2px dashed #E9EDEF; min-height: 250px;">
                            <div class="mb-3">
                                <i class="fa fa-magic fa-3x" style="color: #00A884; opacity: 0.5;" title="Preview Icon"/>
                            </div>
                            <h6 class="text-muted fw-bold">No Template Selected</h6>
                            <p class="small text-muted px-4">Select an approved Meta template on the left to see exactly how it will appear to your customers.</p>
                        </div>
                        
                        <div invisible="template_id == False" class="wa-template-preview-container wa-safe-preview-panel">
                            <div class="fw-bold text-muted text-uppercase small mb-2">Before Send Checklist</div>
                            <field name="template_preview_text" nolabel="1" readonly="1" class="wa-safe-preview-text"/>
                        </div>
                    </div>
                </div>

                <footer>
                    <button name="action_send" string="Send Message" type="object" class="btn-success fw-bold px-4 rounded" style="background: #00A884; border: none;"/>
                    <button string="Cancel" class="btn-light" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_send_whatsapp_wizard" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Message</field>
        <field name="res_model">whatsapp.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
