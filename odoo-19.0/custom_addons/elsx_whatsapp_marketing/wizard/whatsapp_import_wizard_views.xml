<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_import_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.import.wizard.form</field>
        <field name="model">whatsapp.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Import WhatsApp Contacts">
                <sheet>
                    <group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_type"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="campaign_id"/>
                        </group>
                    </group>
                    <group string="Formatting Options">
                        <group>
                            <field name="auto_format_numbers"/>
                            <field name="default_country_code" invisible="not auto_format_numbers"/>
                            <field name="duplicate_policy"/>
                        </group>
                        <group>
                            <field name="default_opt_in"/>
                            <field name="create_missing_tags"/>
                            <field name="default_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <group string="Import Result" invisible="not preview_text and not report_file">
                        <field name="preview_text" nolabel="1" readonly="1"/>
                        <group invisible="not report_file">
                            <field name="imported_count"/>
                            <field name="updated_count"/>
                            <field name="skipped_count"/>
                            <field name="error_count"/>
                            <field name="report_file" filename="report_filename"/>
                            <field name="report_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="template_file" invisible="1"/>
                    <field name="template_filename" invisible="1"/>
                    <footer>
                        <button name="action_download_template" string="Template" type="object" class="btn-secondary" icon="fa-download"/>
                        <button name="action_preview" string="Preview" type="object" class="btn-secondary" icon="fa-search"/>
                        <button name="action_import" string="Import" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_import_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Import Contacts</field>
        <field name="res_model">whatsapp.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
