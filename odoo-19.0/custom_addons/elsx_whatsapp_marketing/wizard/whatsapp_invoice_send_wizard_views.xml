<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_invoice_send_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.invoice.send.wizard.form</field>
        <field name="model">whatsapp.invoice.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Invoice via WhatsApp">
                <sheet>
                    <div class="row">
                        <div class="col-md-7 border-end pe-4">
                            <group>
                                <field name="invoice_id" invisible="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="phone_number" widget="phone" options="{'enable_sms': False}"/>
                                <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="send_mode" widget="radio" options="{'horizontal': True}"/>
                                <field name="template_id" invisible="send_mode != 'template'" required="send_mode == 'template'" options="{'no_create': True}"/>
                                <field name="message_body" invisible="send_mode != 'custom_text'" required="send_mode == 'custom_text'" widget="text"/>
                                <field name="attach_pdf" widget="boolean_toggle"/>
                            </group>
                        </div>
                        <div class="col-md-5 ps-4">
                            <div class="o_horizontal_separator mb-3 text-uppercase fw-bolder">Customer Preview</div>
                            <div class="mt-2 wa-safe-preview-panel">
                                <div class="fw-bold text-muted text-uppercase small mb-2">Before Send Checklist</div>
                                <field name="template_preview_text" nolabel="1" readonly="1" class="wa-safe-preview-text"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Send WhatsApp" name="action_send" type="object" class="btn-primary" icon="fa-whatsapp"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
