<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_chat_bulk_assign_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.chat.bulk.assign.wizard.form</field>
        <field name="model">whatsapp.chat.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Conversations">
                <sheet>
                    <group>
                        <field name="chat_ids" widget="many2many_tags" readonly="1"/>
                        <field name="assigned_user_id" widget="many2one_avatar_user"/>
                        <field name="transfer_reason"/>
                        <field name="transfer_notes"/>
                        <field name="reopen_conversations"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Assign"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_chat_bulk_assign" model="ir.actions.act_window">
        <field name="name">Assign Conversations</field>
        <field name="res_model">whatsapp.chat.bulk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="views" eval="[(False, 'form')]"/>
        <field name="target">new</field>
    </record>

    <record id="server_action_whatsapp_chat_bulk_assign" model="ir.actions.server">
        <field name="name">Assign Conversations</field>
        <field name="model_id" ref="elsx_whatsapp_core.model_whatsapp_chat"/>
        <field name="binding_model_id" ref="elsx_whatsapp_core.model_whatsapp_chat"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('elsx_whatsapp_marketing.action_whatsapp_chat_bulk_assign').read()[0]
action['context'] = {
    'active_model': 'whatsapp.chat',
    'active_ids': records.ids,
    'default_chat_ids': [(6, 0, records.ids)],
}
        </field>
    </record>
</odoo>
