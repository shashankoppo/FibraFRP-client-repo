<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_rebrand" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title>ELSX ERP | Global Strategic Ecosystem</title>
        </xpath>
        <xpath expr="//head" position="inside">
            <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&amp;family=Inter:wght@300;400;700&amp;display=swap" rel="stylesheet"/>
            <link rel="icon" type="image/x-icon" href="/elsx_rebrand/static/src/img/favicon.ico"/>
        </xpath>
    </template>

    <!-- Luxury Cyberpunk Login Page -->
    <template id="login_rebrand" inherit_id="web.login_layout">
         <xpath expr="//div[hasclass('text-center')]" position="replace">
            <div class="text-center mb-4" style="background: rgba(0,0,0,0.6); padding: 40px; border-radius: 20px; border: 1px solid #00DBDE; box-shadow: 0 0 20px #00DBDE;">
                <img src="/elsx_rebrand/static/src/img/logo.png" alt="ELSX ERP" style="max-height: 120px; filter: drop-shadow(0 0 10px #00DBDE);"/>
                <h1 style="color: #00DBDE; font-family: 'Orbitron', sans-serif; font-weight: bold; margin-top: 20px; text-transform: uppercase; letter-spacing: 5px;">ELSX ERP</h1>
                <p style="color: #FC00FF; font-family: 'Inter', sans-serif; font-size: 0.9rem; letter-spacing: 2px;">The Planet's Best Strategic Ecosystem</p>
            </div>
        </xpath>
    </template>
</odoo>
