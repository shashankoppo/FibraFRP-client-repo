<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_rebrand" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'ELSxGlobal'"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/x-icon" href="/elsx_rebrand/static/src/img/favicon.ico"/>
        </xpath>
    </template>

    <template id="brand_promotion_message_rebrand" inherit_id="web.brand_promotion_message">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <a target="_blank" href="https://elsxglobal.com" class="badge text-bg-light text-decoration-none">ELSxGlobal</a>
            </t>
        </xpath>
    </template>

    <template id="login_footer_rebrand" inherit_id="web.login_layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a href="https://elsxglobal.com" target="_blank">Powered by <span>ELSxGlobal</span></a>
        </xpath>
    </template>

    <template id="login_logo_rebrand" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4">
                <img src="/elsx_rebrand/static/src/img/logo.png" alt="ELSxGlobal" style="max-height:120px; max-width:100%; width:auto"/>
            </div>
        </xpath>
    </template>
</odoo>
