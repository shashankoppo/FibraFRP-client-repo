<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_layout_rebrand" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'ELSxGlobal'"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/x-icon" href="/elsx_rebrand/static/src/img/favicon.ico"/>
        </xpath>
    </template>



    <template id="login_logo_rebrand" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4">
                <img src="/elsx_rebrand/static/src/img/logo.png" alt="ELSxGlobal" style="max-height:120px; max-width:100%; width:auto"/>
            </div>
        </xpath>
    </template>

    <template id="webclient_bootstrap_icon_rebrand" inherit_id="web.webclient_bootstrap">
        <xpath expr="//link[@rel='apple-touch-icon']" position="replace">
            <link rel="apple-touch-icon" href="/elsx_rebrand/static/src/img/logo.png"/>
        </xpath>
    </template>

    <template id="webclient_offline_rebrand" inherit_id="web.webclient_offline">
        <xpath expr="//div[hasclass('card')]" position="replace">
            <div class="card">
                <img src="/elsx_rebrand/static/src/img/logo.png" alt="ELSxGlobal logo"/>
                <h1>You are offline</h1>
                <p>Check your network connection and come back here. ELSxGlobal will load as soon as you're back online.</p>
                <button onclick="location.reload()">Check again</button>
            </div>
        </xpath>
    </template>

    <template id="report_layout_title_rebrand" inherit_id="web.report_layout">
        <xpath expr="//title" position="replace">
            <title><t t-esc="title or 'ELSxGlobal Report'"/></title>
        </xpath>
    </template>

    <template id="report_preview_layout_title_rebrand" inherit_id="web.report_preview_layout">
        <xpath expr="//title" position="replace">
            <title><t t-esc="title or 'ELSxGlobal Report'"/></title>
        </xpath>
    </template>
    <template id="brand_promotion_message_hide" inherit_id="web.brand_promotion_message" priority="1000">
        <xpath expr="//t[contains(@t-out, 'final_message')]" position="replace">
            <t/>
        </xpath>
    </template>

    <template id="login_footer_branding_hide" inherit_id="web.login_layout" priority="1000">
        <xpath expr="//a[contains(@href, 'odoo.com') and .//span[contains(., 'Odoo')]]" position="replace">
            <t/>
        </xpath>
    </template>
</odoo>
