<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elsx_rebrand.CustomerDisplayNoPlatformBranding" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[.//OdooLogo]" position="replace">
            <t/>
        </xpath>
    </t>

    <t t-name="elsx_rebrand.OrderReceiptNoPlatformBranding" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-order-data')][.//span[contains(., 'Powered by')]]" position="replace">
            <t/>
        </xpath>
    </t>
</templates>
