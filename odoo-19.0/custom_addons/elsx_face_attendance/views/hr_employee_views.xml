<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_face_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.elsx.face</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_elsx_face_profiles"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user-circle"
                        groups="hr_attendance.group_hr_attendance_manager">
                    <field name="elsx_face_profile_count" widget="statinfo" string="Face Profiles"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="elsx_face_enrolled" readonly="1" groups="hr_attendance.group_hr_attendance_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
