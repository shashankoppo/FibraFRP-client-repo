<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elsx_face_profile_view_list" model="ir.ui.view">
        <field name="name">elsx.face.profile.list</field>
        <field name="model">elsx.face.profile</field>
        <field name="arch" type="xml">
            <list string="Face Profiles">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="active"/>
                <field name="engine"/>
                <field name="quality_score"/>
                <field name="quality_status"/>
                <field name="sample_count"/>
                <field name="last_verified"/>
                <field name="verification_count"/>
                <field name="consent_date"/>
                <field name="consent_user_id"/>
            </list>
        </field>
    </record>

    <record id="elsx_face_profile_view_form" model="ir.ui.view">
        <field name="name">elsx.face.profile.form</field>
        <field name="model">elsx.face.profile</field>
        <field name="arch" type="xml">
            <form string="Face Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="active"/>
                            <field name="engine" readonly="1"/>
                        </group>
                        <group>
                            <field name="quality_score" readonly="1"/>
                            <field name="quality_status" readonly="1"/>
                            <field name="sample_count" readonly="1"/>
                            <field name="last_verified" readonly="1"/>
                            <field name="verification_count" readonly="1"/>
                            <field name="consent_date" readonly="1"/>
                            <field name="consent_user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="elsx_face_verification_log_view_list" model="ir.ui.view">
        <field name="name">elsx.face.verification.log.list</field>
        <field name="model">elsx.face.verification.log</field>
        <field name="arch" type="xml">
            <list string="Face Verification Logs" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="status"/>
                <field name="decision"/>
                <field name="risk_level"/>
                <field name="risk_score"/>
                <field name="confidence"/>
                <field name="quality_score"/>
                <field name="sample_count"/>
                <field name="policy_mode"/>
                <field name="review_required"/>
                <field name="ip_address"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="reason"/>
                <field name="attendance_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="elsx_face_verification_log_view_form" model="ir.ui.view">
        <field name="name">elsx.face.verification.log.form</field>
        <field name="model">elsx.face.verification.log</field>
        <field name="arch" type="xml">
            <form string="Face Verification Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="profile_id"/>
                            <field name="attendance_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="policy_mode"/>
                            <field name="confidence"/>
                            <field name="quality_score"/>
                            <field name="quality_status"/>
                            <field name="sample_count"/>
                            <field name="liveness_status"/>
                        </group>
                    </group>
                    <group>
                        <field name="decision"/>
                        <field name="risk_score"/>
                        <field name="risk_level"/>
                        <field name="review_required"/>
                    </group>
                    <group string="Evidence">
                        <field name="ip_address"/>
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="device_fingerprint_hash"/>
                        <field name="challenge_id"/>
                        <field name="challenge_status"/>
                        <field name="reason"/>
                        <field name="evidence_summary"/>
                    </group>
                    <group string="Sidecar Response">
                        <field name="raw_response" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elsx_face_profiles" model="ir.actions.act_window">
        <field name="name">Face Profiles</field>
        <field name="res_model">elsx.face.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_elsx_face_verification_logs" model="ir.actions.act_window">
        <field name="name">Face Verification Logs</field>
        <field name="res_model">elsx.face.verification.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_elsx_face_attendance_page" model="ir.actions.act_url">
        <field name="name">Face Check In / Out</field>
        <field name="url">/elsx_face_attendance</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_elsx_face_attendance"
              name="Face Attendance"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="12"
              action="action_elsx_face_attendance_page"
              groups="hr_attendance.group_hr_attendance_officer"/>
    <menuitem id="menu_elsx_face_profiles"
              name="Face Profiles"
              parent="hr_attendance.menu_hr_attendance_configuration"
              sequence="20"
              action="action_elsx_face_profiles"
              groups="hr_attendance.group_hr_attendance_manager"/>
    <menuitem id="menu_elsx_face_logs"
              name="Face Verification Logs"
              parent="hr_attendance.menu_hr_attendance_reporting"
              sequence="50"
              action="action_elsx_face_verification_logs"
              groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
