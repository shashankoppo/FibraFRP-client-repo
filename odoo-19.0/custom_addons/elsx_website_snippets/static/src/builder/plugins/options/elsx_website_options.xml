<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="elsx_website_snippets.ElsxWebsiteSectionOption">
    <BuilderRow label.translate="Mood">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-theme-soft'">Calm Trust</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-theme-ocean'">Ocean Tech</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-theme-warm'">Warm Premium</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-theme-luxe'">Luxury Dark</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-theme-gradient'">High Impact</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-theme-graphite'">Graphite</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Psychology">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-psych-trust'">Trust</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-psych-urgency'">Urgency</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-psych-premium'">Premium</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-psych-calm'">Calm</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Density">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-density-compact'">Compact</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-density-balanced'">Balanced</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-density-airy'">Airy</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-density-cinematic'">Cinematic</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Corners">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-radius-none'">Sharp</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-radius-soft'">Soft</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-radius-round'">Round</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-radius-organic'">Organic</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Depth">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-depth-flat'">Flat</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-depth-soft'">Soft Shadow</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-depth-float'">Floating</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-depth-glow'">Glow</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Motion">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-motion-none'">None</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-motion-lift'">Lift</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-motion-glow'">Glow</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-motion-tilt'">Tilt</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Developer">
        <BuilderCheckbox classAction="'elsx-dev-outline'">Show editable zones</BuilderCheckbox>
    </BuilderRow>
</t>

<t t-name="elsx_website_snippets.ElsxLogoSliderOption">
    <BuilderRow label.translate="Items">
        <BuilderButton action="'elsxUpgradeLogoItems'" preview="false">Make Editable</BuilderButton>
        <BuilderButton action="'elsxAddLogoItem'" preview="false">Add Logo</BuilderButton>
    </BuilderRow>
    <BuilderRow label.translate="Active Logo">
        <BuilderSelect action="'elsxSetLogoActive'" preview="false">
            <BuilderSelectItem actionValue="'0'">Logo 1</BuilderSelectItem>
            <BuilderSelectItem actionValue="'1'">Logo 2</BuilderSelectItem>
            <BuilderSelectItem actionValue="'2'">Logo 3</BuilderSelectItem>
            <BuilderSelectItem actionValue="'3'">Logo 4</BuilderSelectItem>
            <BuilderSelectItem actionValue="'4'">Logo 5</BuilderSelectItem>
            <BuilderSelectItem actionValue="'5'">Logo 6</BuilderSelectItem>
            <BuilderSelectItem actionValue="'6'">Logo 7</BuilderSelectItem>
            <BuilderSelectItem actionValue="'7'">Logo 8</BuilderSelectItem>
            <BuilderSelectItem actionValue="'8'">Logo 9</BuilderSelectItem>
            <BuilderSelectItem actionValue="'9'">Logo 10</BuilderSelectItem>
            <BuilderSelectItem actionValue="'10'">Logo 11</BuilderSelectItem>
            <BuilderSelectItem actionValue="'11'">Logo 12</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Logo Type">
        <BuilderSelect action="'elsxSetLogoVariant'">
            <BuilderSelectItem actionValue="'elsx-logo-kind-mark'">Simple Logo</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-kind-partner'">Partner Card</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-kind-cert'">Certificate Badge</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-kind-media'">Media Card</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-kind-chip'">Compact Chip</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Logo Label">
        <BuilderTextInput action="'elsxSetLogoLabel'" default.translate="Client Logo"/>
    </BuilderRow>
    <BuilderRow label.translate="Initials">
        <BuilderTextInput action="'elsxSetLogoInitials'" default.translate="CL"/>
    </BuilderRow>
    <BuilderRow label.translate="Subtitle">
        <BuilderTextInput action="'elsxSetLogoSubtitle'" default.translate="Partner / Certification"/>
    </BuilderRow>
    <BuilderRow label.translate="Logo Link">
        <BuilderTextInput action="'elsxSetLogoHref'" default="'#'"/>
    </BuilderRow>
    <BuilderRow label.translate="Image URL">
        <BuilderTextInput action="'elsxSetLogoImageSrc'" default="''"/>
    </BuilderRow>
    <BuilderRow label.translate="Image Mode">
        <BuilderSelect action="'elsxSetLogoImageMode'">
            <BuilderSelectItem actionValue="'initials'">Initials</BuilderSelectItem>
            <BuilderSelectItem actionValue="'image'">Image</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Item Shape">
        <BuilderSelect action="'elsxSetLogoShape'">
            <BuilderSelectItem actionValue="'elsx-logo-pill'">Pill</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-square'">Square</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-circle'">Circle</BuilderSelectItem>
            <BuilderSelectItem actionValue="'elsx-logo-freeform'">Freeform</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Logo Order">
        <BuilderButton action="'elsxMoveLogoItem'" actionValue="'-1'" preview="false">Move Left</BuilderButton>
        <BuilderButton action="'elsxMoveLogoItem'" actionValue="'1'" preview="false">Move Right</BuilderButton>
    </BuilderRow>
    <BuilderRow label.translate="Manage Logo">
        <BuilderButton action="'elsxDuplicateLogoItem'" preview="false">Duplicate</BuilderButton>
        <BuilderButton action="'elsxRemoveLogoItem'" preview="false">Remove</BuilderButton>
    </BuilderRow>
    <BuilderRow label.translate="Flow">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-marquee-left'">Left</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-marquee-right'">Right</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-marquee-static'">Static Grid</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Speed">
        <BuilderRange styleAction="'--elsx-logo-speed'" min="8" max="80" step="2" unit="'s'" displayRangeValue="true"/>
    </BuilderRow>
    <BuilderRow label.translate="Logo Style">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-logo-carded'">Cards</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-logo-outline'">Outline</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-logo-glass'">Glass</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-logo-minimal'">Minimal</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Logo Size">
        <BuilderSelect>
            <BuilderSelectItem classAction="'elsx-logo-size-sm'">Small</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-logo-size-md'">Medium</BuilderSelectItem>
            <BuilderSelectItem classAction="'elsx-logo-size-lg'">Large</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

