<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep Settings available to system administrators and route Apps through
         the password gate. Standard Odoo login/groups still protect module
         management; the secret URL remains available as a controlled admin shortcut. -->

    <record id="action_apps_password_gate" model="ir.actions.act_url">
        <field name="name">Apps Password Gate</field>
        <field name="url">/elsx/apps/unlock</field>
        <field name="target">self</field>
    </record>

    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="action" eval="'ir.actions.act_url,%d' % ref('elsx_client_restrictions.action_apps_password_gate')"/>
        <field name="active" eval="True"/>
    </record>

    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="action" eval="'ir.actions.act_url,%d' % ref('elsx_client_restrictions.action_apps_password_gate')"/>
        <field name="active" eval="True"/>
    </record>

    <record id="base.menu_module_tree" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="action" eval="'ir.actions.act_url,%d' % ref('elsx_client_restrictions.action_apps_password_gate')"/>
        <field name="active" eval="True"/>
    </record>

    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('base_setup.action_general_configuration')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
