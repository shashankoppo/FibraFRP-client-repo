<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compatibility menu data. Standard Odoo administrator groups remain in charge. -->
    
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="active" eval="False"/>
    </record>

    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="active" eval="False"/>
    </record>
    
    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

</odoo>

