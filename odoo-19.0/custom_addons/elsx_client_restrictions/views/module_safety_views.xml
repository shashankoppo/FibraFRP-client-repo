<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elsx_module_safety_wizard_form" model="ir.ui.view">
        <field name="name">elsx.module.safety.wizard.form</field>
        <field name="model">elsx.module.safety.wizard</field>
        <field name="arch" type="xml">
            <form string="Safe Module Change">
                <sheet>
                    <group>
                        <field name="operation"/>
                        <field name="module_ids" widget="many2many_tags"/>
                        <field name="backup_confirmed"/>
                    </group>
                    <group string="Impact Summary">
                        <field name="impact_summary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_plan" type="object" string="Run Preflight" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_elsx_module_safety_wizard" model="ir.actions.act_window">
        <field name="name">Safe Module Change</field>
        <field name="res_model">elsx.module.safety.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_elsx_module_safety"
              name="Safe Module Change"
              parent="base.menu_administration"
              sequence="95"
              action="action_elsx_module_safety_wizard"
              groups="base.group_system"/>
</odoo>
