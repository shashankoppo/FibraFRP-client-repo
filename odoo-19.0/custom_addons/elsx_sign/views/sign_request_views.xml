<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elsx_sign_request_form" model="ir.ui.view">
        <field name="name">elsx.sign.request.form</field>
        <field name="model">elsx.sign.request</field>
        <field name="arch" type="xml">
            <form string="Signature Request">
                <header>
                    <button name="action_send_request" string="📧 Send for Signature" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_decline" string="Decline" type="object" class="btn btn-danger"
                            invisible="state not in ('sent',)"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('declined','signed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_send_request" type="object" class="oe_stat_button" icon="fa-envelope"
                                invisible="state != 'sent'">
                            <div class="o_stat_info"><span class="o_stat_text">Sent</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Document Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="document_attachment_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="sign_url" widget="url" invisible="state == 'draft'"/>
                            <field name="signed_date" invisible="state != 'signed'"/>
                            <field name="signer_ip" invisible="state != 'signed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="✅ Signature Capture" invisible="state != 'signed'">
                            <field name="signature_image" widget="image" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_elsx_sign_request" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">elsx.sign.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_elsx_sign_root" name="Signatures" sequence="50" web_icon="elsx_sign,static/description/icon.png"/>
    <menuitem id="menu_elsx_sign_requests" name="Requests" parent="menu_elsx_sign_root" action="action_elsx_sign_request" sequence="10"/>

</odoo>
