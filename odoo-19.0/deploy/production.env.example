# REFERENCE ONLY. Merge into the existing VPS .env; never replace its credentials.
# Keep the existing Compose directory/project name and all volume identities.
ODOO_AUTO_UPDATE_DB_NAME=FiberaFRP_DB
BACKUP_PASSPHRASE=
ODOO_AUTO_ALLOW_INSTALL=NO
# Keep existing POSTGRES_USER / POSTGRES_PASSWORD unchanged.
# Remove INSTALL_MODULES, EXTRA_INSTALL_MODULES and ODOO_AUTO_INSTALL_MODULES.
# NEW_INSTALL_MODULES is ignored by production and may remain from initial setup.
# Apps uses the configured salted hash by default; no plaintext password is needed here.
