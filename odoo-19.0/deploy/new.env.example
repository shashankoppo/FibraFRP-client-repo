# SEPARATE FRESH VPS ONLY. Do not use this file to replace a client's existing .env.
# These matching names allow deploy-prod.sh to update this same DB after initial setup.
NEW_DB_NAME=ClientERP
ODOO_AUTO_UPDATE_DB_NAME=ClientERP
NEW_INSTALL_MODULES=sale_management,stock,account,crm,elsx_whatsapp_marketing,elsx_client_restrictions
ODOO_AUTO_ALLOW_INSTALL=NO
POSTGRES_USER=odoo
# Provide distinct strong secrets through this private file or VPS/CI configuration.
POSTGRES_PASSWORD=
NEW_DB_ADMIN_PASSWORD=
BACKUP_PASSPHRASE=
# Existing Apps password is hashed in the guard. No plaintext Apps secret here.
