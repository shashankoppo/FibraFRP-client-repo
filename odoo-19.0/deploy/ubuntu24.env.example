# Legacy reference only. Use production.env.example or new.env.example instead.
# Never replace an existing client's .env or database credentials with this file.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-before-production

# Must match Odoo system parameter whatsapp.sidecar.secret when sidecar relay is used.
SIDECAR_SECRET=change-me-sidecar-secret

# Optional. Fill only if Meta calls the sidecar webhook directly.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
