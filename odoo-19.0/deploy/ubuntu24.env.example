POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-before-production

# Must match Odoo system parameter whatsapp.sidecar.secret when sidecar relay is used.
SIDECAR_SECRET=change-me-sidecar-secret

# Required for sidecar health and webhook signature verification.
WHATSAPP_VERIFY_TOKEN=change-me-meta-verify-token
META_APP_SECRET=change-me-meta-app-secret
