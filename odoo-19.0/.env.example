# Select the Docker compose file for this host.
# Ubuntu / Alpine VM / bare metal production:
COMPOSE_FILE=docker-compose.prod.yml
# Alpine Proxmox LXC fallback when Docker cannot write ip_unprivileged_port_start:
# COMPOSE_FILE=docker-compose.alpine-lxc.yml

# Optional but recommended only before the first deploy: set once and never change it.
# On an existing production server, first check the current compose project name
# with docker compose ls; changing it makes Docker use a different named-volume
# set and can make the existing database look missing even though the old volume
# still exists.
# COMPOSE_PROJECT_NAME=odoo-190

POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace_with_a_strong_database_password
# Recommended: a separate secret for encrypted pre-upgrade database backups.
# When omitted, the automatic upgrader falls back to POSTGRES_PASSWORD so the
# normal Compose command remains backup-first on existing hosts.
BACKUP_PASSPHRASE=replace_with_a_strong_backup_passphrase
# Used only by docker-compose.alpine-lxc.yml host-network fallback.
POSTGRES_PORT=5432

# Normal `docker compose up -d --build` deployments run an idempotent,
# backup-first Odoo upgrade before the application starts. Set NO only for
# diagnosed emergency recovery; incompatible code may not start safely.
ELSX_AUTO_UPGRADE=YES
# Optional override. Normally a source fingerprint is calculated automatically.
# ELSX_AUTO_UPGRADE_RELEASE=

# All three values are required. Missing values make sidecar health fail closed.
SIDECAR_SECRET=replace_with_a_strong_sidecar_secret
WHATSAPP_VERIFY_TOKEN=replace_with_meta_verify_token
META_APP_SECRET=replace_with_meta_app_secret

# Host/runtime port overrides. In Alpine LXC host-network mode these are the
# actual service ports, so make sure they are free on the host.
ODOO_HTTP_PORT=8069
SIDECAR_HTTP_PORT=3000
FACE_SIDECAR_HTTP_PORT=8071

# Odoo runtime tuning. Defaults intentionally disable Odoo memory ceilings for
# low-memory Alpine installs; set explicit byte values only after capacity review.
ODOO_LIMIT_MEMORY_HARD=0
ODOO_LIMIT_MEMORY_SOFT=0
ODOO_DB_MAXCONN=64
ODOO_MAX_CRON_THREADS=1

# Optional CORS restriction for the WhatsApp sidecar.
SIDECAR_CORS_ORIGIN=*
