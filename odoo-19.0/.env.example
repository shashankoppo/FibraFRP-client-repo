POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace_with_a_strong_database_password
SIDECAR_SECRET=replace_with_a_strong_sidecar_secret
WHATSAPP_VERIFY_TOKEN=replace_with_meta_verify_token
